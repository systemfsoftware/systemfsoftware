{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/bundler/no-dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect/entrypoint"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.app.tsbuildinfo",
    "outDir": "node_modules/.cache/tsc/app",
    "types": [
      "node"
    ],
    "customConditions": [
      "@systemfsoftware/source"
    ]
  },
  "include": [
    "bin",
    "src"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
