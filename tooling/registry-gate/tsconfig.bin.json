{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/bundler/dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect/entrypoint"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.bin.tsbuildinfo",
    "outDir": "node_modules/.cache/tsc/bin",
    "types": [
      "node"
    ],
    "customConditions": [
      "@systemfsoftware/source"
    ]
  },
  "include": [
    "bin"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
