{
  "$schema": "https://raw.githubusercontent.com/systemfsoftware/gritlint/1d60be38284be2c9a8af73f67334d43a841c9fd7/npm/gritlint/configuration_schema.json",
  "packs": {
    "source-resolution": {
      "condition": "r\"['\\\"]@systemfsoftware/source['\\\"]\"",
      "presets": "r\"\\\"@systemfsoftware/tsconfig/.*\\\"\"",
      "presetFiles": "r\".*/tsconfig/(?:(?:bundler|tsc)/.*|node)\\.json\"",
      "sharedVitestConfig": "r\"['\\\"]@systemfsoftware/vitest-config['\\\"]\"",
      "sharedVitestConfigFile": "r\".*/vitest-config/lib/base\\.js\""
    },
    "typecheck-build-mode": {},
    "npm-provenance": {
      "repositoryUrl": "`\"git+https://github.com/systemfsoftware/systemfsoftware.git\"`"
    }
  },
  "ignore": [
    "repos/**"
  ]
}
