{
  "role": "workflow",
  "operation": "admitSurvivorsRun",
  "typeId": {
    "namespace": "@systemfsoftware/stryker-js-cli",
    "name": "SurvivorsAdmission",
    "export": true
  },
  "command": {
    "type": "AdmitSurvivorsRunInput",
    "from": "./survivors.kernel.js"
  },
  "aliases": [
    { "name": "SurvivorsRejectReason", "literals": ["no-report", "mismatch"] }
  ],
  "decision": {
    "union": { "name": "SurvivorsAdmission" },
    "variants": [
      {
        "class": "Admitted",
        "tag": "Admitted",
        "fields": {
          "survivors": {
            "kind": "array",
            "of": {
              "kind": "struct",
              "fields": {
                "id": { "kind": "string" },
                "fileName": { "kind": "string" },
                "mutatorName": { "kind": "string" },
                "replacement": { "kind": "string" },
                "location": {
                  "kind": "struct",
                  "fields": {
                    "start": {
                      "kind": "struct",
                      "fields": { "line": { "kind": "number" }, "column": { "kind": "number" } }
                    },
                    "end": {
                      "kind": "struct",
                      "fields": { "line": { "kind": "number" }, "column": { "kind": "number" } }
                    }
                  }
                }
              }
            }
          }
        }
      },
      { "class": "NoSurvivors", "tag": "NoSurvivors", "fields": {} }
    ]
  },
  "error": {
    "variants": [
      {
        "class": "SurvivorsRejection",
        "tag": "SurvivorsRejection",
        "fields": {
          "reason": { "kind": "literal", "of": ["no-report", "mismatch"] },
          "remediation": { "kind": "string" }
        }
      }
    ]
  },
  "dispatch": {
    "on": {
      "call": "admissionVerdict",
      "from": "./survivors.kernel.js",
      "args": [{ "path": ["command"] }]
    },
    "bind": "verdict",
    "arms": [
      {
        "pattern": { "kind": "reject" },
        "channel": "left",
        "construct": "SurvivorsRejection",
        "with": {
          "reason": { "field": { "path": ["verdict", "reason"] } },
          "remediation": { "field": { "path": ["verdict", "remediation"] } }
        }
      },
      {
        "pattern": { "kind": "no-survivors" },
        "channel": "right",
        "construct": "NoSurvivors",
        "with": {}
      },
      {
        "pattern": { "kind": "admit" },
        "channel": "right",
        "construct": "Admitted",
        "with": { "survivors": { "field": { "path": ["verdict", "survivors"] } } }
      }
    ]
  }
}
