{
  "workspace": ["./oxlint-guard"],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/jsonc": "jsr:@std/jsonc@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/testing": "jsr:@std/testing@^1",
    "fast-check": "npm:fast-check@^4",
    "valibot": "jsr:@valibot/valibot@^1"
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": false,
    "singleQuote": true,
    "exclude": ["**/dist"]
  },
  "lint": {
    "exclude": ["**/dist"]
  }
}
