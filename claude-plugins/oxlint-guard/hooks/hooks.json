{
  "description": "Lint each edit with oxlint (PostToolUse) and block edits that add off severities to the oxlint config (PreToolUse). Both hooks run hermetic Deno scripts with --allow-read --allow-run --allow-env only — no network access.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Update|MultiEdit|Create|morph_mcp_edit-file|morph_edit",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-read --allow-run --allow-env ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/oxlint-guard.ts",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Update|MultiEdit|Create|morph_mcp_edit-file|morph_edit",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-read --allow-run --allow-env ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/oxlint-config-off-guard.ts",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
