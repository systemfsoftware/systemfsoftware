{
  "name": "systemfsoftware",
  "private": true,
  "description": "System F Software — Effect-TS libraries and the oxlint plugin that enforces the constitution.",
  "type": "module",
  "scripts": {
    "build": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} build",
    "typecheck": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue typecheck",
    "test": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} test",
    "lint": "pnpm format:check && turbo --concurrency=${TURBO_CONCURRENCY:-50%} lint ${AGENT:+-- --format=unix}",
    "lint:ci": "pnpm format:check && turbo --concurrency=${TURBO_CONCURRENCY:-50%} lint -- --format=github",
    "api:check": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} api:check",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "precommit": "pnpm exec lint-staged --no-revert",
    "pre-push": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue format:check lint typecheck test attw api:check && pnpm check:exports && pnpm check:mutate-scope && pnpm check:lint-coverage && pnpm check:no-hand-rolled-jsonc",
    "check": "pnpm install --frozen-lockfile && turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue format:check lint typecheck test attw api:check && pnpm check:exports && pnpm check:mutate-scope && pnpm check:lint-coverage && pnpm check:no-hand-rolled-jsonc",
    "check:ci": "turbo --concurrency=${TURBO_CONCURRENCY:-100%} --continue format:check lint typecheck test attw api:check && pnpm check:exports && pnpm check:mutate-scope && pnpm check:lint-coverage && pnpm check:no-hand-rolled-jsonc",
    "release": "node scripts/release.mjs",
    "prepare": "concurrently \"husky\" \"effect-tsgo patch\"",
    "release:dry": "node scripts/release.mjs --dry-run",
    "bump:minor": "node scripts/bump-all-minor.mjs",
    "publish:check": "node scripts/validate-publish-config.mjs",
    "attw": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} attw",
    "check:exports": "node scripts/check-exports.mjs",
    "check:mutate-scope": "node scripts/guard-mutate-scope.mjs",
    "check:lint-coverage": "node scripts/check-lint-coverage.mjs",
    "check:no-hand-rolled-jsonc": "node scripts/guard-no-hand-rolled-jsonc.mjs --selftest && node scripts/guard-no-hand-rolled-jsonc.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/config-pnpm-scopes": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@effect/tsgo": "^0.24.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "catalog:",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "concurrently": "^9.2.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "dprint": "^0.54.0",
    "estree-walker": "^3",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "semantic-release": "^24.2.9",
    "turbo": "^2.10.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.9.0"
}
