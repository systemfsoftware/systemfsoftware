{
  "name": "systemfsoftware",
  "private": true,
  "description": "System F Software — Effect-TS libraries and the oxlint plugin that enforces the constitution.",
  "type": "module",
  "scripts": {
    "build": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} build",
    "typecheck": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue typecheck",
    "test": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} test",
    "lint": "pnpm format:check && turbo --concurrency=${TURBO_CONCURRENCY:-50%} lint",
    "api:check": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} api:check",
    "format": "./bin/dprint fmt",
    "format:check": "./bin/dprint check",
    "precommit": "pnpm exec lint-staged --no-revert --config .lintstagedrc.js",
    "check": "pnpm install --frozen-lockfile && TURBO_CONCURRENCY=${TURBO_CONCURRENCY:-50%} pnpm check:ci",
    "gate:tasks": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue lint lint:tsgo typecheck test test:types attw api:check",
    "gate:dist": "turbo --concurrency=${TURBO_CONCURRENCY:-100%} build",
    "check:suppression": "deno run --allow-read --allow-run=git scripts/guards/check-rule-suppression.ts",
    "check:ci": "s=0; pnpm format:check || s=1; pnpm check:boundaries || s=1; pnpm check:suppression || s=1; TURBO_CONCURRENCY=${TURBO_CONCURRENCY:-100%} pnpm gate:tasks test:contract || s=1; pnpm gate:dist || s=1; exit $s",
    "check:local": "s=0; ./bin/dprint check || s=1; pnpm check:boundaries || s=1; pnpm check:suppression || s=1; TURBO_CONCURRENCY=${TURBO_CONCURRENCY:-100%} pnpm gate:tasks || s=1; pnpm gate:dist || s=1; exit $s",
    "prepare": "concurrently \"husky\" \"node scripts/tools/patch-tsgo-if-needed.mjs\"",
    "map": "deno run --allow-read=. --allow-run=git scripts/tools/workspace-map.ts",
    "publish:unpublished": "./scripts/tools/publish-and-setup-npm-trust.ts",
    "attw": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} attw",
    "check:boundaries": "turbo boundaries",
    "pack:all": "node scripts/tools/pack-all.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/config-pnpm-scopes": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@effect/tsgo": "^0.36.5",
    "@std/jsonc": "catalog:",
    "@systemfsoftware/stryker-js-cli": "workspace:^",
    "@systemfsoftware/stryker-js-mutation-run": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "workspace:^",
    "@systemfsoftware/stryker-js-vitest-runner": "workspace:^",
    "@systemfsoftware/stryker-test-contribution": "workspace:^",
    "concurrently": "^10.0.5",
    "estree-walker": "^3",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "mutation-testing-elements": "3.7.3",
    "mutation-testing-metrics": "3.7.3",
    "oxc-parser": "catalog:",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "tstyche-typescript": "npm:typescript@6.0.3",
    "turbo": "^2.10.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.21.0"
}
