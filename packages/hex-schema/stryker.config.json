{
  "extends": "@systemfsoftware/stryker-js-core/config/base",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.d.ts",
    "!src/mod.ts"
  ],
  "plugins": [
    "@stryker-mutator/vitest-runner",
    "@systemfsoftware/stryker-js-typescript-checker",
    "@systemfsoftware/stryker-plugins"
  ],
  "mutator": {
    "excludedMutations": []
  },
  "ignorers": [
    "effect-schema-declarations",
    "in-source-vitest-block"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": null
}
