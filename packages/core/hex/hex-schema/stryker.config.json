{
  "extends": "../../../../stryker.config.base.json",
  "mutate": [
    "src/**/*.workflow.ts",
    "!src/**/*.test.ts",
    "!src/**/*.d.ts",
    "!src/mod.ts",
    "!src/**/*.kernel.ts"
  ],
  "plugins": [
    "@systemfsoftware/stryker-js-vitest-runner",
    "@systemfsoftware/stryker-js-typescript-checker",
    "@systemfsoftware/stryker-plugins"
  ],
  "mutator": {
    "excludedMutations": []
  },
  "ignorers": [
    "effect-schema-declarations",
    "in-source-vitest-block"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": null
}
