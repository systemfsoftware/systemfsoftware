{
  "name": "@systemfsoftware/effect-cell-types",
  "license": "Apache-2.0",
  "version": "5.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/core/effect/cell/types"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/core/effect/cell/types#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Type-level contracts for the repo's cell taxonomy, starting with the Workflow decision channel — branded Workflow<C, D, E> types plus a runtime make constructor every effect kernel can share.",
  "keywords": [
    "effect",
    "effect-ts",
    "typescript",
    "architecture",
    "workflow",
    "either",
    "type-contracts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown && pnpm api:check",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run --passWithNoTests",
    "test:types": "TSTYCHE_TYPESCRIPT_MODULE=tstyche-typescript tstyche",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:*",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "tstyche": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
