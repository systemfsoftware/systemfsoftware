{
  "name": "@systemfsoftware/effect-cell-type-tests",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/core/effect/cell/type-tests"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/core/effect/cell/type-tests#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Type-level test generator for Cell descriptions: walks the vocabulary of @systemfsoftware/effect-cell-types at generation time and emits the tstyche suite that pins the phase types and their chain order over the description's public export root.",
  "keywords": [
    "effect",
    "effect-ts",
    "typescript",
    "architecture",
    "type-testing",
    "tstyche",
    "codegen",
    "cell"
  ],
  "type": "module",
  "scripts": {
    "generate": "deno run --config scripts/deno.jsonc --allow-read=.,../effect-cell-types,../../node_modules --allow-write=test-types scripts/generate-type-tests.ts",
    "typecheck": "pnpm generate && tsc --noEmit --incremental",
    "test:types": "pnpm generate && TSTYCHE_TYPESCRIPT_MODULE=tstyche-typescript tstyche",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "check:scripts": "deno check --config scripts/deno.jsonc scripts/generate-type-tests.ts && deno lint --config scripts/deno.jsonc scripts"
  },
  "dependencies": {
    "@systemfsoftware/effect-cell-types": "workspace:^"
  },
  "devDependencies": {
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "tstyche": "catalog:",
    "tstyche-typescript": "npm:typescript@6.0.3"
  }
}
