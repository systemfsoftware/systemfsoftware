{
  "name": "@systemfsoftware/project-modules-node",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/core/effect/project-modules-node"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/core/effect/project-modules-node#readme",
  "bugs": "https://github.com/systemfsoftware/issues",
  "description": "Node host layer for @systemfsoftware/project-modules — resolves and imports modules from a project directory through the host resolver.",
  "keywords": [
    "effect",
    "modules",
    "resolution",
    "node",
    "plugin-loading"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/project-modules-node.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}"
  },
  "dependencies": {
    "@systemfsoftware/project-modules": "workspace:^"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@systemfsoftware/all": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/project-modules-node.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  }
}
