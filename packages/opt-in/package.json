{
  "name": "@systemfsoftware/opt-in",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/opt-in"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/opt-in#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Per-package opt-ins for the repo's shared guards: a decoded, branded opt-in vocabulary plus pure renderers that project it into oxlint overrides and the @effect/language-service plugin block, with an `opt-in sync` CLI.",
  "keywords": [
    "effect",
    "effect-ts",
    "oxlint",
    "tsgo",
    "opt-in",
    "configuration",
    "tooling"
  ],
  "type": "module",
  "bin": {
    "opt-in": "./src/cli.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@std/jsonc": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "bin": {
      "opt-in": "./dist/cli.mjs"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
