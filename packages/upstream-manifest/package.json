{
  "name": "@systemfsoftware/upstream-manifest",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/upstream-manifest"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/upstream-manifest#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Grade imported upstream test suites against the commit and tree they came from — verbatim bytes, marked port regions, retired cases, generated test projects and formatter excludes — from one upstream-family.json per family, with an `upstream-manifest check|--write|--selftest` CLI.",
  "keywords": [
    "effect",
    "effect-ts",
    "upstream",
    "fork",
    "testing",
    "conformance",
    "tooling"
  ],
  "type": "module",
  "bin": {
    "upstream-manifest": "./src/cli.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "lint:tsgo": "effect-tsgo diagnostics --project tsconfig.app.json --format ${TSGO_FORMAT:-text} && effect-tsgo diagnostics --project tsconfig.test.json --format ${TSGO_FORMAT:-text}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/oxlint-plugin-recommended": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "bin": {
      "upstream-manifest": "./dist/cli.mjs"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@effect/platform-node": "4.0.1",
    "@effect/platform-node-shared": "4.0.1",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "chai": "6.2.2",
    "expect-type": "1.4.0",
    "magic-string": "1.4.1",
    "tinybench": "6.1.4",
    "vite": "8.2.1",
    "vitest": "5.0.1"
  }
}
