{
  "name": "@systemfsoftware/oxlint-plugin-effect-schema",
  "license": "Apache-2.0",
  "version": "5.5.1",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/oxlint-plugin/oxlint-plugin-effect-schema"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/oxlint-plugin/oxlint-plugin-effect-schema#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Oxlint rules for Effect Schema declarations: tagged errors and schema file shape.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "oxc",
    "lint",
    "linter",
    "lint-rules",
    "effect",
    "effect-ts",
    "schema",
    "property-testing"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/oxlint-plugin-effect-schema.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown -l warn && pnpm api:check",
    "clean": "rimraf dist",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@oxc-project/types": "catalog:",
    "@oxlint/plugins": "catalog:oxlint"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/oxlint-import-origin": "workspace:^",
    "@systemfsoftware/stryker-config": "workspace:^",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:stryker",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "catalog:stryker",
    "@systemfsoftware/stryker-js": "catalog:stryker",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:stryker",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:stryker",
    "@systemfsoftware/stryker-test-contribution": "catalog:stryker",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/oxlint-plugin-effect-schema.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
