{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect"
  ],
  "compilerOptions": {
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "../oxlint-plugin-effect-schema/src/rules/*.corpus.ts",
    "../oxlint-plugin-effect-schema/src/rules/schema-bare-primitive-field.config.ts",
    "../oxlint-plugin-effect-schema/src/rules/schema-brand-requires-filter.config.ts",
    "../oxlint-plugin-cell-vocabulary/src/rules/*.corpus.ts",
    "../oxlint-plugin-property-testing/src/rules/no-ignored-draw.corpus.ts",
    "../oxlint-plugin-property-testing/src/rules/no-ignored-draw.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
