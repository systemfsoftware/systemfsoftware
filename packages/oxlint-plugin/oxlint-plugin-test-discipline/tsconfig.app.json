{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/dom/library-monorepo"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.app.tsbuildinfo",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc/app"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
