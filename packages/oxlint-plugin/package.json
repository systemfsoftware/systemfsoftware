{
  "name": "@systemfsoftware/oxlint-plugin",
  "license": "MIT",
  "version": "0.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/oxlint-plugin"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/oxlint-plugin#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Oxlint rules for Effect-TS — enforce a pure functional core and imperative shell: ban classes and string errors, forbid native Date/Promise/timers in Effect, require pipeable composition.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "oxc",
    "lint",
    "linter",
    "lint-rules",
    "effect",
    "effect-ts",
    "functional-programming",
    "static-analysis",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "format": "dprint fmt",
    "test": "vitest run",
    "test:run": "vitest run --coverage",
    "mutation": "stryker run --incremental",
    "mutation:full": "stryker run",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}"
  },
  "dependencies": {
    "@oxc-project/types": "^0.126.0",
    "@oxlint/plugins": "^1.60.0",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@systemfsoftware/stryker-js-core": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "workspace:^",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "oxlint": "^1.60.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "vitest": "^4"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
