{
  "name": "@systemfsoftware/oxlint-plugin-recommended",
  "license": "Apache-2.0",
  "version": "1.3.3",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/oxlint-plugin/oxlint-plugin-recommended"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/oxlint-plugin/oxlint-plugin-recommended#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Shared oxlint presets shipped as plugin configs: recommended, cell-architecture, dmmf and rule-authoring.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "oxc",
    "lint",
    "linter",
    "effect",
    "effect-ts",
    "dmmf",
    "cell-architecture"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown -l warn && pnpm api:check",
    "clean": "rimraf dist",
    "typecheck": "tsc -b",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@effect/tsgo": "catalog:",
    "@systemfsoftware/oxlint-plugin-cell-architecture": "workspace:^",
    "@systemfsoftware/oxlint-plugin-dmmf-workflow": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-platform": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-schema": "workspace:^",
    "@systemfsoftware/oxlint-plugin-test-discipline": "workspace:^"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/oxlint-plugin-recommended.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/oxlint-plugin-recommended.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
