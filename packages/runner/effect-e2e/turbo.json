{
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.ts",
        "src/**/*.ts",
        "tests/**/*.ts",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "outputs": [
        "coverage/**"
      ],
      "dependsOn": ["^build"]
    }
  }
}
