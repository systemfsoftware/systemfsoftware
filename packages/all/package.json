{
  "name": "@systemfsoftware/all",
  "license": "Apache-2.0",
  "version": "0.2.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/all"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/all#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "The whole stack in one install: every published @systemfsoftware package, plus an oxlint preset whose default export turns on every recommended cell rule — the workflow, schema, test-placement, property-testing, hygiene and vocabulary tiers — without any repo-internal config.",
  "keywords": [
    "effect",
    "effect-ts",
    "cell-architecture",
    "oxlint",
    "oxlint-config",
    "preset",
    "meta-package",
    "monorepo",
    "schema",
    "workflow",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown && pnpm api:check",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:run": "vitest run",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "dependencies": {
    "@systemfsoftware/arethetypeswrong-cli": "workspace:^",
    "@systemfsoftware/arethetypeswrong-core": "workspace:^",
    "@systemfsoftware/effect-atom": "workspace:^",
    "@systemfsoftware/effect-atom-react": "workspace:^",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/effect-daemon-spec": "workspace:^",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-memfs": "workspace:^",
    "@systemfsoftware/effect-schema-extensions": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/hex-schema": "workspace:^",
    "@systemfsoftware/omp-agent-discipline": "workspace:^",
    "@systemfsoftware/omp-claude-compat": "workspace:^",
    "@systemfsoftware/oxlint-plugin": "workspace:^",
    "@systemfsoftware/oxlint-plugin-cell-vocabulary": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-dmmf": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-entrypoint": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-schema": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-workflow": "workspace:^",
    "@systemfsoftware/oxlint-plugin-property-testing": "workspace:^",
    "@systemfsoftware/oxlint-plugin-recommended": "workspace:^",
    "@systemfsoftware/oxlint-plugin-test-hygiene": "workspace:^",
    "@systemfsoftware/oxlint-plugin-test-placement": "workspace:^",
    "@systemfsoftware/rx-effect": "workspace:^",
    "@systemfsoftware/storybook-gherkin": "workspace:^",
    "@systemfsoftware/stryker-js-cli": "workspace:^",
    "@systemfsoftware/stryker-js-mutation-report": "workspace:^",
    "@systemfsoftware/stryker-js-mutation-run": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-api": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "workspace:^",
    "@systemfsoftware/stryker-js-vitest-runner": "workspace:^",
    "@systemfsoftware/stryker-plugins": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@stryker-mutator/api": "catalog:stryker",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rxjs": "^7",
    "scheduler": "*",
    "storybook": ">=10.0.0",
    "typescript": ">=5.0.0",
    "vite": ">5.0.0",
    "vitest": ">=4.1.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "@effect/vitest": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@stryker-mutator/api": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "scheduler": {
      "optional": true
    },
    "storybook": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/all.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/all.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
