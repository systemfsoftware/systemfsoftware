{
  "name": "@systemfsoftware/effect-atom",
  "license": "Apache-2.0",
  "version": "4.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/atom/effect-atom"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/atom/effect-atom#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Reactive toolkit for Effect — forked under systemfsoftware from tim-smart/effect-atom.",
  "keywords": [
    "effect",
    "effect-ts",
    "atom",
    "reactive",
    "state"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./Atom": {
      "@systemfsoftware/source": "./src/Atom.ts",
      "types": "./dist/Atom.d.ts",
      "default": "./dist/Atom.mjs"
    },
    "./AtomHttpApi": {
      "@systemfsoftware/source": "./src/AtomHttpApi.ts",
      "types": "./dist/AtomHttpApi.d.ts",
      "default": "./dist/AtomHttpApi.mjs"
    },
    "./AtomRef": {
      "@systemfsoftware/source": "./src/AtomRef.ts",
      "types": "./dist/AtomRef.d.ts",
      "default": "./dist/AtomRef.mjs"
    },
    "./AtomRpc": {
      "@systemfsoftware/source": "./src/AtomRpc.ts",
      "types": "./dist/AtomRpc.d.ts",
      "default": "./dist/AtomRpc.mjs"
    },
    "./Hydration": {
      "@systemfsoftware/source": "./src/Hydration.ts",
      "types": "./dist/Hydration.d.ts",
      "default": "./dist/Hydration.mjs"
    },
    "./Registry": {
      "@systemfsoftware/source": "./src/Registry.ts",
      "types": "./dist/Registry.d.ts",
      "default": "./dist/Registry.mjs"
    },
    "./Result": {
      "@systemfsoftware/source": "./src/Result.ts",
      "types": "./dist/Result.d.ts",
      "default": "./dist/Result.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm dts:check && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --config oxlint.config.ts --format=${f:-default}",
    "lint:tsgo": "effect-tsgo diagnostics --project tsconfig.app.json --format ${TSGO_FORMAT:-text} && effect-tsgo diagnostics --project tsconfig.test.json --format ${TSGO_FORMAT:-text}",
    "attw": "attw --pack .",
    "dts:check": "tsc --noEmit -p tsconfig.dts.json",
    "api:check": "concurrently --kill-others-on-fail \"api-extractor-quiet run\" \"api-extractor-quiet run --config api-extractor.Atom.json\" \"api-extractor-quiet run --config api-extractor.AtomRef.json\" \"api-extractor-quiet run --config api-extractor.AtomRpc.json\" \"api-extractor-quiet run --config api-extractor.AtomHttpApi.json\" \"api-extractor-quiet run --config api-extractor.Hydration.json\" \"api-extractor-quiet run --config api-extractor.Registry.json\" \"api-extractor-quiet run --config api-extractor.Result.json\"",
    "api:update": "concurrently --kill-others-on-fail \"api-extractor run --local\" \"api-extractor run --local --config api-extractor.Atom.json\" \"api-extractor run --local --config api-extractor.AtomRef.json\" \"api-extractor run --local --config api-extractor.AtomRpc.json\" \"api-extractor run --local --config api-extractor.AtomHttpApi.json\" \"api-extractor run --local --config api-extractor.Hydration.json\" \"api-extractor run --local --config api-extractor.Registry.json\" \"api-extractor run --local --config api-extractor.Result.json\""
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/conformance-spec": "workspace:^",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./Atom": {
        "types": "./dist/Atom.d.ts",
        "default": "./dist/Atom.mjs"
      },
      "./AtomHttpApi": {
        "types": "./dist/AtomHttpApi.d.ts",
        "default": "./dist/AtomHttpApi.mjs"
      },
      "./AtomRef": {
        "types": "./dist/AtomRef.d.ts",
        "default": "./dist/AtomRef.mjs"
      },
      "./AtomRpc": {
        "types": "./dist/AtomRpc.d.ts",
        "default": "./dist/AtomRpc.mjs"
      },
      "./Hydration": {
        "types": "./dist/Hydration.d.ts",
        "default": "./dist/Hydration.mjs"
      },
      "./Registry": {
        "types": "./dist/Registry.d.ts",
        "default": "./dist/Registry.mjs"
      },
      "./Result": {
        "types": "./dist/Result.d.ts",
        "default": "./dist/Result.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
