{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.app.tsbuildinfo",
    "types": [],
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc/app"
  },
  "include": ["src"]
}
