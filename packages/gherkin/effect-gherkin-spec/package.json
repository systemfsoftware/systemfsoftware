{
  "name": "@systemfsoftware/effect-gherkin-spec",
  "license": "Apache-2.0",
  "version": "5.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/gherkin/effect-gherkin-spec"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/gherkin/effect-gherkin-spec#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Gherkin BDD for Effect-TS and Vitest — Given/When/Then steps that compose as Effects, with Scenario Outline expansion and typed step errors.",
  "keywords": [
    "effect",
    "effect-ts",
    "vitest",
    "gherkin",
    "bdd",
    "cucumber",
    "given-when-then",
    "scenario-outline",
    "acceptance-testing",
    "property-testing",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:types": "TSTYCHE_TYPESCRIPT_MODULE=tstyche-typescript tstyche",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@systemfsoftware/effect-spec-runtime": "workspace:^"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "tstyche": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@systemfsoftware/vitest": "workspace:^",
    "effect": "catalog:peers",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
