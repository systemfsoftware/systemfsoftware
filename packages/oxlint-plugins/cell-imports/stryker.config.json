{
  "$schema": "./node_modules/@systemfsoftware/stryker-js-core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "checkers": [
    "typescript"
  ],
  "plugins": [
    "@stryker-mutator/vitest-runner",
    "@systemfsoftware/stryker-js-typescript-checker",
    "@systemfsoftware/stryker-plugins/effect-schema-ignorer"
  ],
  "reporters": [
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation-report.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-report.json"
  },
  "vitest": {
    "configFile": "vitest.config.ts",
    "dir": ".",
    "related": true
  },
  "typescriptChecker": {
    "prioritizePerformanceOverAccuracy": false
  },
  "coverageAnalysis": "perTest",
  "incremental": false,
  "incrementalFile": "reports/stryker-incremental.json",
  "mutate": [
    "src/rules/*.ts",
    "!src/rules/**/*.test.ts",
    "!src/rules/*.config.ts"
  ],
  "ignorePatterns": [
    "reports",
    "coverage"
  ],
  "ignorers": [
    "effect-schema-declarations"
  ],
  "thresholds": {
    "high": 100,
    "low": 80,
    "break": 100
  }
}
