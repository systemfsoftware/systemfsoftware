{
  "name": "@systemfsoftware/oxlint-plugin-effect-dmmf",
  "license": "MIT",
  "version": "1.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/oxlint-plugins/effect-dmmf"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/oxlint-plugins/effect-dmmf#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Combined oxlint plugin bundling the DMMF operation trio under one entrypoint: pure decisions (effect-workflow), the operation shell (effect-executor), and their property-test verification altitude (property-testing).",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "oxc",
    "lint",
    "linter",
    "lint-rules",
    "effect",
    "effect-ts",
    "dmmf",
    "workflow",
    "executor",
    "property-testing",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/oxlint-plugin-effect-dmmf.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && pnpm api:check",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "format": "dprint fmt",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}",
    "attw": "attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:oxlint",
    "@systemfsoftware/oxlint-plugin-effect-executor": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-workflow": "workspace:^",
    "@systemfsoftware/oxlint-plugin-property-testing": "workspace:^"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxlint": "catalog:oxlint"
  },
  "publishConfig": {
    "provenance": true
  }
}
