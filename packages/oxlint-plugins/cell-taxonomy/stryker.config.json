{
  "extends": "@systemfsoftware/stryker-js-core/config/base",
  "mutate": [
    "src/rules/*.ts",
    "!src/rules/**/*.test.ts",
    "!src/rules/*.config.ts"
  ],
  "plugins": [
    "@stryker-mutator/vitest-runner",
    "@systemfsoftware/stryker-js-typescript-checker"
  ],
  "vitest": {
    "configFile": "vitest.config.ts",
    "dir": ".",
    "related": false
  },
  "coverageAnalysis": "off",
  "ignorers": null
}
