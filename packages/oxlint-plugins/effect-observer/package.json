{
  "name": "@systemfsoftware/oxlint-plugin-effect-observer",
  "license": "MIT",
  "version": "1.0.2",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/oxlint-plugins/effect-observer"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/oxlint-plugins/effect-observer#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Oxlint rules enforcing the *.observer.ts cell — operational-vocabulary test machinery with no domain imports, no escaping module state, and no production importers.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "oxc",
    "lint",
    "linter",
    "lint-rules",
    "effect",
    "effect-ts",
    "observer",
    "test-harness",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/oxlint-plugin-effect-observer.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && pnpm api:check",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "format": "dprint fmt",
    "test": "vitest run",
    "test:run": "vitest run --coverage",
    "mutation": "stryker run",
    "mutation:full": "stryker run",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}",
    "attw": "attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@oxc-project/types": "^0.140.0",
    "@oxlint/plugins": "catalog:oxlint"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:stryker",
    "@systemfsoftware/arethetypeswrong-cli": "workspace:^",
    "@systemfsoftware/stryker-js-core": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
