{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@systemfsoftware/tsconfig/tsc/dom/library-monorepo", "@systemfsoftware/tsconfig/effect"],
  "compilerOptions": {
    "customConditions": [
      "@systemfsoftware/source"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/rules/__tests__"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
