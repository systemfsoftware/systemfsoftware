{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@systemfsoftware/tsconfig/tsc/dom/library-monorepo", "@systemfsoftware/tsconfig/effect"],
  "compilerOptions": {
    "customConditions": [
      "@systemfsoftware/source"
    ],
    // The make-boundary kernel drift test reads both vendored copies from disk
    // (`node:fs`); node is the only @types package this leaf installs.
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
