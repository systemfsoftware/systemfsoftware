{
  "name": "@systemfsoftware/oxlint-plugin",
  "license": "Apache-2.0",
  "version": "0.4.2",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/oxlint-plugins/core"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/oxlint-plugins/core#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Oxlint rules for Effect-TS \u2014 enforce a pure functional core and imperative shell: ban classes and string errors, forbid native Date/Promise/timers in Effect, require pipeable composition.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "oxc",
    "linter",
    "lint-rules",
    "effect",
    "effect-ts",
    "functional-programming",
    "static-analysis",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/oxlint-plugin.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && pnpm api:check",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "format": "dprint fmt",
    "test": "vitest run",
    "test:run": "vitest run --coverage",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@oxc-project/types": "^0.140.0",
    "@oxlint/plugins": "catalog:oxlint"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/stryker-js-mutation-run": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "workspace:^",
    "@systemfsoftware/stryker-js-vitest-runner": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
