{
  "name": "@systemfsoftware/effect-gherkin-spec",
  "license": "MIT",
  "version": "0.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/effect-gherkin-spec"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/effect-gherkin-spec#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Gherkin BDD for Effect-TS and Vitest — Given/When/Then steps that compose as Effects, with Scenario Outline expansion and typed step errors.",
  "keywords": [
    "effect",
    "effect-ts",
    "vitest",
    "gherkin",
    "bdd",
    "cucumber",
    "given-when-then",
    "scenario-outline",
    "acceptance-testing",
    "property-testing",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:types": "tstyche",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}"
  },
  "devDependencies": {
    "@effect/vitest": "0.29.0",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "^24",
    "effect": "^3.21.2",
    "fast-check": "^3",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.3",
    "tstyche": "^7.1.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4"
  },
  "peerDependencies": {
    "@effect/vitest": "*",
    "effect": "*",
    "vitest": "*"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
