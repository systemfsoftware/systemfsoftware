{
  "name": "@systemfsoftware/arethetypeswrong-cli",
  "version": "1.1.1",
  "description": "A CLI tool for arethetypeswrong.github.io — owned and maintained by systemfsoftware",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/arethetypeswrong/cli"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "bin": {
    "attw": "./dist/main.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "node ./dist/main.mjs --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "test": "vitest run",
    "test:run": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "prepack": "pnpm build"
  },
  "type": "module",
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@systemfsoftware/arethetypeswrong-core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-dmmf": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
