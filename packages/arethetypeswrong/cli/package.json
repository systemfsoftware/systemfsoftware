{
  "name": "@systemfsoftware/arethetypeswrong-cli",
  "version": "1.0.5",
  "description": "A CLI tool for arethetypeswrong.github.io — forked under systemfsoftware",
  "author": "Andrew Branch & ej-shafran (forked by systemfsoftware)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/arethetypeswrong/cli"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "bin": {
    "attw": "./dist/index.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./internal/getExitCode": "./dist/getExitCode.mjs",
    "./internal/render": "./dist/render/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "format": "dprint fmt",
    "test": "vitest run",
    "test:run": "vitest run --coverage",
    "prepack": "pnpm build"
  },
  "type": "module",
  "dependencies": {
    "@systemfsoftware/arethetypeswrong-core": "workspace:*",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.3",
    "commander": "^15.0.0",
    "marked": "^18.0.7",
    "marked-terminal": "^7.1.0",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/marked": "^6.0.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "catalog:",
    "@types/semver": "^7.5.3",
    "rimraf": "catalog:",
    "ts-expose-internals": "^5.6.0",
    "tsdown": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
