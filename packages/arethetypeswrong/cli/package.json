{
  "name": "@systemfsoftware/arethetypeswrong-cli",
  "version": "1.1.1",
  "description": "A CLI tool for arethetypeswrong.github.io — forked under systemfsoftware",
  "author": "Andrew Branch & ej-shafran (forked by systemfsoftware)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/arethetypeswrong/cli"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "bin": {
    "attw": "./dist/main.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:run": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "prepack": "pnpm build"
  },
  "type": "module",
  "dependencies": {
    "@effect/cli": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/printer": "catalog:",
    "@systemfsoftware/arethetypeswrong-core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-dmmf": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "rimraf": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/stryker-js-mutation-run": "workspace:^",
    "@systemfsoftware/stryker-js-vitest-runner": "workspace:^"
  },
  "engines": {
    "node": ">=24"
  }
}
