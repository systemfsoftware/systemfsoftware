{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@systemfsoftware/tsconfig/tsc/dom/library-monorepo",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitReturns": false,
    "noImplicitOverride": false,
    "noPropertyAccessFromIndexSignature": false,
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "types": [
      "node",
      "ts-expose-internals"
    ],
    // Fork of arethetypeswrong.github.io: the constitution policy in
    // @systemfsoftware/tsconfig/effect is deliberately NOT extended here, so the upstream diff stays
    // mergeable. The Effect Language Service runs at its own defaults — correctness tier only.
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
