{
  "name": "@systemfsoftware/arethetypeswrong-core",
  "version": "1.1.1",
  "description": "The API behind arethetypeswrong.github.io — owned and maintained by systemfsoftware",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/arethetypeswrong/core"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:run": "vitest run --coverage",
    "prepack": "pnpm build"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.mjs"
    },
    "./problems": {
      "types": "./dist/problems.d.ts",
      "default": "./dist/problems.mjs"
    },
    "./versions": {
      "types": "./dist/versions.d.ts",
      "default": "./dist/versions.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@andrewbranch/untar.js": "^1.0.3",
    "@loaderkit/resolve": "^1.0.2",
    "cjs-module-lexer": "^1.2.3",
    "effect": "catalog:",
    "fflate": "^0.8.3",
    "lru-cache": "^11.0.1",
    "semver": "^7.5.4",
    "typescript": "catalog:attw",
    "validate-npm-package-name": "^5.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/semver": "^7.5.0",
    "@types/validate-npm-package-name": "^4.0.0",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "ts-expose-internals": "^5.6.0",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
