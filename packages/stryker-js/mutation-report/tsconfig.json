{
  "extends": "@systemfsoftware/tsconfig/tsc/no-dom/library",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "verbatimModuleSyntax": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": false,
    "noImplicitReturns": false,
    "noImplicitOverride": false,
    "preserveConstEnums": false,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    // Fork of @stryker-mutator/core's reporters: the leaf AGENTS.md mandates a minimal upstream
    // diff, so the constitution policy in @systemfsoftware/tsconfig/effect is deliberately NOT
    // extended here. The Effect Language Service runs at its own defaults — the correctness tier
    // only.
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
