{
  "name": "@systemfsoftware/stryker-js-mutation-report",
  "version": "1.2.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/stryker-js/mutation-report"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/stryker-js/mutation-report#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "The reporter adapters of the @systemfsoftware Stryker fork \u2014 clear-text, progress, HTML, JSON, and NDJSON-stream presentation.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown && pnpm api:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@stryker-mutator/api": "catalog:stryker",
    "@systemfsoftware/stryker-js-mutation-run": "workspace:^",
    "chalk": "~5.6.0",
    "emoji-regex": "~10.6.0",
    "mutation-testing-elements": "3.7.3",
    "mutation-testing-metrics": "3.7.3",
    "progress": "~2.0.3",
    "typed-inject": "~5.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/oxlint-plugin-cell-taxonomy": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/progress": "2.0.7",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "provenance": true,
    "exports": {
      ".": "./dist/index.mjs",
      "./stryker-plugins": "./dist/stryker-plugins.mjs",
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./stryker-plugins": {
      "@systemfsoftware/source": "./src/stryker-plugins.ts",
      "default": "./dist/stryker-plugins.mjs"
    },
    "./package.json": "./package.json"
  }
}
