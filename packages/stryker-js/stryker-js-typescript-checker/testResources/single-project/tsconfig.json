{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "outDir": "dist",

    // These settings should be overridden by the typescript checker
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "types": []
