{
  "name": "@systemfsoftware/stryker-js-typescript-checker",
  "version": "0.1.0",
  "description": "TypeScript checker plugin for Stryker — TS7 native",
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/util": "^9.6.1",
    "semver": "^7.7.0",
    "tslib": "~2.8.0",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "^24",
    "@types/semver": "^7.5.8",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.9",
    "vitest": "^4"
  }
}
