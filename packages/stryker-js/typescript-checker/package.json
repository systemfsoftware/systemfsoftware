{
  "name": "@systemfsoftware/stryker-js-typescript-checker",
  "version": "1.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/stryker-js/typescript-checker"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/stryker-js/typescript-checker#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "TypeScript checker plugin for Stryker — TS7 native",
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@stryker-mutator/api": "catalog:stryker",
    "@stryker-mutator/util": "catalog:stryker",
    "effect": "catalog:",
    "semver": "catalog:stryker",
    "tslib": "catalog:stryker",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@std/jsonc": "catalog:",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/semver": "^7.5.8",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "inlinedDependencies": {
    "@jsr/std__jsonc": "1.0.2"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
