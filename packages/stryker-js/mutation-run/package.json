{
  "name": "@systemfsoftware/stryker-js-mutation-run",
  "version": "1.2.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/stryker-js/mutation-run"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/stryker-js/mutation-run#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "A source-code fork of @stryker-mutator/core",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./checker-worker": "./dist/checker-worker.mjs",
      "./child-process-proxy-worker": "./dist/child-process-proxy-worker.mjs",
      "./child-process-test-runner-worker": "./dist/child-process-test-runner-worker.mjs",
      "./config/base": "./dist/config/base.mjs",
      "./config/config-resolution": "./dist/config/config-resolution.mjs",
      "./config/fork-schema": "./dist/config/fork-schema.mjs",
      "./errors": "./dist/errors.mjs",
      "./exit-classification": "./dist/exit-classification.mjs",
      "./mutants/incremental-differ": "./dist/mutants/incremental-differ.mjs",
      "./output-mode": "./dist/output-mode.mjs",
      "./plugins": "./dist/plugins.mjs",
      "./run-event": "./dist/run-event.mjs",
      "./stryker-package": "./dist/stryker-package.mjs",
      "./timer": "./dist/timer.mjs",
      "./verdict-envelope": "./dist/verdict-envelope.mjs",
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./checker-worker": {
      "@systemfsoftware/source": "./src/checker/checker-worker.ts",
      "default": "./dist/checker-worker.mjs"
    },
    "./child-process-proxy-worker": {
      "@systemfsoftware/source": "./src/worker-pool/child-process-proxy-worker.ts",
      "default": "./dist/child-process-proxy-worker.mjs"
    },
    "./child-process-test-runner-worker": {
      "@systemfsoftware/source": "./src/test-runner/child-process-test-runner-worker.ts",
      "default": "./dist/child-process-test-runner-worker.mjs"
    },
    "./config/base": {
      "@systemfsoftware/source": "./src/config/base-preset.ts",
      "default": "./dist/config/base.mjs"
    },
    "./config/config-resolution": {
      "@systemfsoftware/source": "./src/config/config-resolution.ts",
      "default": "./dist/config/config-resolution.mjs"
    },
    "./config/fork-schema": {
      "@systemfsoftware/source": "./src/config/fork-schema.ts",
      "default": "./dist/config/fork-schema.mjs"
    },
    "./errors": {
      "@systemfsoftware/source": "./src/errors.ts",
      "default": "./dist/errors.mjs"
    },
    "./exit-classification": {
      "@systemfsoftware/source": "./src/exit-classification.ts",
      "default": "./dist/exit-classification.mjs"
    },
    "./mutants/incremental-differ": {
      "@systemfsoftware/source": "./src/mutants/incremental-differ.ts",
      "default": "./dist/mutants/incremental-differ.mjs"
    },
    "./output-mode": {
      "@systemfsoftware/source": "./src/output-mode.ts",
      "default": "./dist/output-mode.mjs"
    },
    "./plugins": {
      "@systemfsoftware/source": "./src/plugins/index.ts",
      "default": "./dist/plugins.mjs"
    },
    "./run-event": {
      "@systemfsoftware/source": "./src/run-event.ts",
      "default": "./dist/run-event.mjs"
    },
    "./stryker-package": {
      "@systemfsoftware/source": "./src/stryker-package.ts",
      "default": "./dist/stryker-package.mjs"
    },
    "./timer": {
      "@systemfsoftware/source": "./src/timer.ts",
      "default": "./dist/timer.mjs"
    },
    "./verdict-envelope": {
      "@systemfsoftware/source": "./src/verdict-envelope.ts",
      "default": "./dist/verdict-envelope.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "build": "tsdown && pnpm api:check",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "lint": "oxlint",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force"
  },
  "dependencies": {
    "@stryker-mutator/api": "catalog:stryker",
    "@stryker-mutator/instrumenter": "catalog:stryker",
    "@stryker-mutator/util": "catalog:stryker",
    "ajv": "~8.18.0",
    "diff-match-patch": "1.0.5",
    "execa": "~9.6.0",
    "lodash.groupby": "~4.6.0",
    "minimatch": "~10.2.4",
    "mutation-testing-metrics": "3.7.3",
    "mutation-testing-report-schema": "3.7.3",
    "npm-run-path": "~6.0.0",
    "rxjs": "~7.8.1",
    "semver": "catalog:stryker",
    "source-map": "~0.7.4",
    "tree-kill": "~1.2.2",
    "tslib": "catalog:stryker",
    "typed-inject": "~5.0.0"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@std/jsonc": "catalog:",
    "@systemfsoftware/oxlint-plugin-cell-taxonomy": "workspace:^",
    "@systemfsoftware/stryker-js-vitest-runner": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/diff-match-patch": "1.0.36",
    "@types/json-schema": "7.0.15",
    "@types/lodash.groupby": "4.6.9",
    "@types/node": "catalog:",
    "@types/semver": "7.7.1",
    "effect": "catalog:",
    "glob": "13.0.6",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "inlinedDependencies": {
    "@jsr/std__jsonc": "1.0.2",
    "@types/json-schema": "7.0.15"
  }
}
