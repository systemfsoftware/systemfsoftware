{
  "name": "@systemfsoftware/stryker-js-engine",
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/stryker-js/stryker-js-engine"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/stryker-js/stryker-js-engine#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "The host-neutral mutation engine — the run, its stages, and the ports a process entry binds to start it.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "build": "tsdown && pnpm api:check",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "tsdown && concurrently --kill-others-on-fail \"api-extractor run\" \"api-extractor run --config api-extractor.base.json\" \"api-extractor run --config api-extractor.builtin-reporters.json\" \"api-extractor run --config api-extractor.worker.json\"",
    "api:update": "concurrently --kill-others-on-fail \"api-extractor run --local\" \"api-extractor run --local --config api-extractor.base.json\" \"api-extractor run --local --config api-extractor.builtin-reporters.json\" \"api-extractor run --local --config api-extractor.worker.json\""
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@opentelemetry/api": "^1.9.0",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/stryker-js": "workspace:^",
    "@systemfsoftware/stryker-js-instrumenter": "workspace:^",
    "diff-match-patch": "1.0.5",
    "minimatch": "~10.2.6"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@std/jsonc": "catalog:",
    "@systemfsoftware/all": "workspace:^",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/diff-match-patch": "1.0.36",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./builtin-reporters": {
        "types": "./dist/builtin-reporters.d.mts",
        "default": "./dist/builtin-reporters.mjs"
      },
      "./config/base": {
        "types": "./dist/config/base.d.mts",
        "default": "./dist/config/base.mjs"
      },
      "./worker": {
        "types": "./dist/worker.d.mts",
        "default": "./dist/worker.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./builtin-reporters": {
      "@systemfsoftware/source": "./src/builtin-reporters.ts",
      "types": "./dist/builtin-reporters.d.mts",
      "default": "./dist/builtin-reporters.mjs"
    },
    "./config/base": {
      "@systemfsoftware/source": "./src/config/base.ts",
      "types": "./dist/config/base.d.mts",
      "default": "./dist/config/base.mjs"
    },
    "./worker": {
      "@systemfsoftware/source": "./src/worker-wiring.ts",
      "types": "./dist/worker.d.mts",
      "default": "./dist/worker.mjs"
    },
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@jsr/std__jsonc": "1.0.2"
  }
}
