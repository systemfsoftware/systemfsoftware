{
  "extends": "@systemfsoftware/stryker-js-core/config/base",
  "mutate": [
    "src/reporters/test-contribution.ts"
  ],
  "$schema": "./schema/stryker-schema.json",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.stryker.config.ts",
    "dir": ".",
    "related": true
  },
  "reporters": [
    "progress",
    "json"
  ],
  "ignorePatterns": [
    "reports",
    "coverage",
    "dist"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "checkers": null,
  "htmlReporter": null,
  "typescriptChecker": null,
  "incrementalFile": null,
  "ignorers": null
}
