{
  "name": "@systemfsoftware/stryker-js-core",
  "version": "1.0.0",
  "description": "A source-code fork of @stryker-mutator/core",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./checker-worker": "./dist/checker-worker.mjs",
      "./child-process-proxy-worker": "./dist/child-process-proxy-worker.mjs",
      "./child-process-test-runner-worker": "./dist/child-process-test-runner-worker.mjs",
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./checker-worker": {
      "@systemfsoftware/source": "./src/checker/checker-worker.ts",
      "default": "./dist/checker-worker.mjs"
    },
    "./child-process-proxy-worker": {
      "@systemfsoftware/source": "./src/child-proxy/child-process-proxy-worker.ts",
      "default": "./dist/child-process-proxy-worker.mjs"
    },
    "./child-process-test-runner-worker": {
      "@systemfsoftware/source": "./src/test-runner/child-process-test-runner-worker.ts",
      "default": "./dist/child-process-test-runner-worker.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "stryker": "./bin/stryker.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.0.0",
    "@stryker-mutator/api": "catalog:stryker",
    "@stryker-mutator/instrumenter": "catalog:stryker",
    "@stryker-mutator/util": "catalog:stryker",
    "ajv": "~8.18.0",
    "chalk": "~5.6.0",
    "commander": "~14.0.0",
    "diff-match-patch": "1.0.5",
    "emoji-regex": "~10.6.0",
    "execa": "~9.6.0",
    "json-rpc-2.0": "^1.7.0",
    "lodash.groupby": "~4.6.0",
    "minimatch": "~10.2.4",
    "mutation-server-protocol": "~0.4.0",
    "mutation-testing-elements": "3.7.3",
    "mutation-testing-metrics": "3.7.3",
    "mutation-testing-report-schema": "3.7.3",
    "npm-run-path": "~6.0.0",
    "progress": "~2.0.3",
    "rxjs": "~7.8.1",
    "semver": "catalog:stryker",
    "source-map": "~0.7.4",
    "tree-kill": "~1.2.2",
    "tslib": "catalog:stryker",
    "typed-inject": "~5.0.0",
    "typed-rest-client": "~2.3.0"
  },
  "devDependencies": {
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/diff-match-patch": "1.0.36",
    "@types/json-schema": "7.0.15",
    "@types/lodash.groupby": "4.6.9",
    "@types/node": "catalog:",
    "@types/progress": "2.0.7",
    "@types/semver": "7.7.1",
    "glob": "13.0.6",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0"
}
