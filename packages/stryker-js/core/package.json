{
  "name": "@systemfsoftware/stryker-js-core",
  "version": "0.1.0",
  "description": "A source-code fork of @stryker-mutator/core",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
