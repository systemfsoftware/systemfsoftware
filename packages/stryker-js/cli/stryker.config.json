{
  "extends": "@systemfsoftware/stryker-js-mutation-run/config/base",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.property.test.ts",
    "!src/**/*.d.ts",
    "!src/**/__tests__/**"
  ],
  "disableBail": true,
  "plugins": [
    "@systemfsoftware/stryker-js-vitest-runner"
  ],
  "reporters": [
    "progress",
    "json"
  ],
  "ignorePatterns": [
    "reports",
    "coverage",
    "dist"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "htmlReporter": null,
  "ignorers": [
    "effect-schema-declarations",
    "workflow-make-boundary"
  ]
}
