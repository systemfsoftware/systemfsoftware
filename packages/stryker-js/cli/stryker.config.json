{
  "extends": "@systemfsoftware/stryker-js-core/config/base",
  "mutate": [
    "src/**/*.workflow.ts"
  ],
  "disableBail": true,
  "plugins": [
    "@systemfsoftware/stryker-js-vitest-runner"
  ],
  "reporters": [
    "progress",
    "json"
  ],
  "ignorePatterns": [
    "reports",
    "coverage",
    "dist"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "checkers": null,
  "htmlReporter": null,
  "typescriptChecker": null,
  "ignorers": null
}
