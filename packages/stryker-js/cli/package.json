{
  "name": "@systemfsoftware/stryker-js-cli",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/stryker-js/cli"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/stryker-js/cli#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "The stryker command-line interface — terminal framing, run-event stream, and exit handling for the @systemfsoftware Stryker fork.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "attw --pack .",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@stryker-mutator/util": "catalog:stryker",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/stryker-js-mutation-report": "workspace:^",
    "@systemfsoftware/stryker-js-mutation-run": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-api": "workspace:^",
    "effect": "catalog:",
    "semver": "catalog:stryker"
  },
  "devDependencies": {
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/oxlint-plugin-cell-vocabulary": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-entrypoint": "workspace:^",
    "@systemfsoftware/oxlint-plugin-test-placement": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "provenance": true
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "stryker": "./dist/main.mjs"
  }
}
