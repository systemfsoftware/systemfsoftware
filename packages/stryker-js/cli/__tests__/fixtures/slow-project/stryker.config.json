{
  "testRunner": "command",
  "coverageAnalysis": "off",
  "reporters": [
    "progress-stream"
  ],
  "mutate": [
    "src/**/*.js"
  ],
  "tempDirName": ".stryker-tmp",
  "plugins": [],
  "concurrency": 1,
  "timeoutMS": 60000,
  "thresholds": {
    "high": 100,
    "low": 80,
    "break": 0
  }
}
