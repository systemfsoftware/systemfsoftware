{
  "name": "@systemfsoftware/stryker-js-cli",
  "version": "7.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/stryker-js/stryker-js-cli"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/stryker-js/stryker-js-cli#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "The stryker command-line interface — the whole mutation host: run orchestration, the instrumenter core, the builtin and html reporters, the Node platform binding, and the workers.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "attw --pack .",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "mutation": "node ./dist/main.mjs run",
    "mutation:full": "node ./dist/main.mjs run --force",
    "api:check": "echo 'no API report for CLI (dts: false)' && exit 0",
    "api:update": "echo 'no API report for CLI (dts: false)' && exit 0"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@eslint-community/regexpp": "4.12.2",
    "@noble/hashes": "1.8.0",
    "@opentelemetry/api": "^1.9.0",
    "@oxc-project/types": "catalog:",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/stryker-js": "workspace:^",
    "diff-match-patch": "1.0.5",
    "minimatch": "~10.2.4",
    "mutation-testing-elements": "catalog:stryker",
    "oxc-parser": "catalog:"
  },
  "devDependencies": {
    "@std/jsonc": "catalog:",
    "@systemfsoftware/all": "workspace:^",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "workspace:^",
    "@systemfsoftware/stryker-js-vitest-runner": "workspace:^",
    "@systemfsoftware/stryker-plugins": "workspace:^",
    "@systemfsoftware/stryker-test-contribution": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/diff-match-patch": "1.0.36",
    "@types/estree": "1.0.8",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:oxlint",
    "effect": "catalog:",
    "rimraf": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "provenance": true
  },
  "exports": {
    "./package.json": "./package.json",
    "./config": "./dist/config.mjs"
  },
  "bin": {
    "stryker": "./dist/main.mjs"
  },
  "inlinedDependencies": {
    "@jsr/std__jsonc": "1.0.2",
    "detect-libc": "2.1.2",
    "effect": "4.0.0-rc.112",
    "msgpackr": "2.0.5",
    "msgpackr-extract": "3.0.4",
    "node-gyp-build-optional-packages": "5.2.2"
  }
}
