{
  // The generator runs under Deno, and this config is what makes its one import resolve.
  //
  // `nodeModulesDir: "manual"` is load-bearing, not decoration: without it the bare
  // `@systemfsoftware/effect-cell-types` import fails with `Import ... not a dependency`,
  // because the description package exists only as a pnpm symlink under `node_modules` and
  // has no registry copy to resolve from. Deno honours the key here because `scripts/` holds
  // no `package.json`, so this file is a workspace root in its own right — moved next to the
  // package's `package.json` it is a workspace *member*, and Deno then warns that the key is
  // root-only and ignores it.
  "nodeModulesDir": "manual",
  // No lockfile. Deno writes `deno.lock` at the repo root rather than beside this config, and
  // its contents are whichever npm graph the last Deno script happened to touch — a churning
  // root artifact duplicating versions `pnpm-lock.yaml` already owns. Nothing here needs
  // pinning: the only import resolves to a workspace symlink, never to the registry.
  "lock": false,
  "lint": {
    "rules": {
      "include": ["no-sync-fn-in-async-fn"],
    },
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
  },
}
