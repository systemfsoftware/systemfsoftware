{
  "name": "@systemfsoftware/oxlint-config-dmmf",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/oxlint-presets/oxlint-config-dmmf"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/oxlint-presets/oxlint-config-dmmf#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Shareable Oxlint configuration for DMMF: deterministic model-driven development with pure workflows, Effect Schema laws, property testing, and cyclomatic complexity <= 2.",
  "keywords": [
    "oxlint",
    "oxlint-config",
    "preset",
    "dmmf",
    "workflow",
    "effect",
    "schema",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn",
    "typecheck": "tsc --noEmit --incremental",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "dependencies": {
    "@effect/tsgo": "catalog:",
    "@systemfsoftware/oxlint-plugin-dmmf-workflow": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-schema": "workspace:^",
    "@systemfsoftware/oxlint-plugin-test-discipline": "workspace:^",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint"
  },
  "devDependencies": {
    "@systemfsoftware/oxlint-config-rule-authoring": "workspace:^",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
