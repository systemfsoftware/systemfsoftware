{
  "name": "@systemfsoftware/oxlint-config-rule-authoring",
  "license": "Apache-2.0",
  "version": "1.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/oxlint-presets/oxlint-config-rule-authoring"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/oxlint-presets/oxlint-config-rule-authoring#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Shareable Oxlint configuration for authoring custom Oxlint AST plugins: no disk access, RuleTester conventions, and pure AST constraints.",
  "keywords": [
    "oxlint",
    "oxlint-config",
    "preset",
    "rule-authoring",
    "ast",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn",
    "typecheck": "tsc -b",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "dependencies": {
    "oxlint": "catalog:oxlint"
  },
  "devDependencies": {
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@types/node": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxlint": "catalog:oxlint",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
