{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/bundler/dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect/entrypoint"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tstyche.tsbuildinfo",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "test-types"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.test.json"
    }
  ]
}
