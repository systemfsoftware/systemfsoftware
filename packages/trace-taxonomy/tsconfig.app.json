{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/bundler/dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc/app",
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.app.tsbuildinfo",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src"
  ]
}
