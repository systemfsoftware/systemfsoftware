{
  "name": "@systemfsoftware/stryker-test-contribution",
  "license": "Apache-2.0",
  "version": "1.1.2",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/testing/mutation/plugins/stryker-test-contribution"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/testing/mutation/plugins/stryker-test-contribution#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Stryker evaluator addon that fails a run when a required test file kills no mutant that another test file does not also kill.",
  "keywords": [
    "stryker",
    "stryker-mutator",
    "mutation-testing",
    "test-contribution",
    "test-quality",
    "evaluator"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/stryker-test-contribution.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && pnpm api:check",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@systemfsoftware/stryker-js": "workspace:^",
    "@systemfsoftware/stryker-js-platform-node": "workspace:^"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/stryker-test-contribution.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
