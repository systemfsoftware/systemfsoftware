{
  "name": "@systemfsoftware/stryker-js-engine",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/testing/mutation/stryker-js/engine"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/testing/mutation/stryker-js/engine#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "The host-neutral mutation engine — the run, its stages, and the ports a process entry binds to start it.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "build": "tsdown",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/stryker-js": "workspace:^",
    "@systemfsoftware/stryker-js-instrumenter": "workspace:^",
    "diff-match-patch": "1.0.5",
    "minimatch": "~10.2.4",
    "mutation-testing-metrics": "catalog:stryker",
    "mutation-testing-report-schema": "catalog:stryker"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@std/jsonc": "catalog:",
    "@systemfsoftware/all": "workspace:^",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/oxlint-plugin-test-placement": "workspace:*",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/diff-match-patch": "1.0.36",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.mjs",
      "./builtin-reporters": "./dist/builtin-reporters.mjs",
      "./config/base": "./dist/config/base.mjs",
      "./worker": "./dist/worker.mjs",
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./builtin-reporters": {
      "@systemfsoftware/source": "./src/builtin-reporters.ts",
      "default": "./dist/builtin-reporters.mjs"
    },
    "./config/base": {
      "@systemfsoftware/source": "./src/config/base.ts",
      "default": "./dist/config/base.mjs"
    },
    "./worker": {
      "@systemfsoftware/source": "./src/worker-wiring.ts",
      "default": "./dist/worker.mjs"
    },
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@jsr/std__jsonc": "1.0.2"
  }
}
