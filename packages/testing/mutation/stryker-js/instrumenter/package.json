{
  "name": "@systemfsoftware/stryker-js-instrumenter",
  "version": "2.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/testing/mutation/stryker-js/instrumenter"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/testing/mutation/stryker-js/instrumenter#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "The code instrumenter used by the Stryker mutation runner",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "attw --pack .",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@babel/core": "~7.29.0",
    "@babel/generator": "~7.29.0",
    "@babel/parser": "~7.29.0",
    "@babel/plugin-proposal-decorators": "~7.29.0",
    "@babel/plugin-transform-explicit-resource-management": "~7.29.0",
    "@babel/preset-typescript": "~7.28.0",
    "@eslint-community/regexpp": "4.12.2",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/stryker-js": "workspace:^",
    "angular-html-parser": "~10.4.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@systemfsoftware/all": "workspace:^",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/babel__core": "7.20.5",
    "@types/babel__generator": "7.27.0",
    "@types/estree": "1.0.8",
    "@types/node": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "svelte": "5.55.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "provenance": true,
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
