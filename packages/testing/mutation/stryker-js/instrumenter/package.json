{
  "name": "@systemfsoftware/stryker-js-instrumenter",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/testing/mutation/stryker-js/instrumenter"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/testing/mutation/stryker-js/instrumenter#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "The code instrumenter used by the Stryker mutation runner",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "attw --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@babel/core": "~7.29.0",
    "@babel/generator": "~7.29.0",
    "@babel/parser": "~7.29.0",
    "@babel/plugin-proposal-decorators": "~7.29.0",
    "@babel/plugin-transform-explicit-resource-management": "^7.28.0",
    "@babel/preset-typescript": "~7.28.0",
    "@systemfsoftware/stryker-js-plugin-api": "workspace:^",
    "@systemfsoftware/stryker-js-util": "workspace:^",
    "angular-html-parser": "~10.4.0",
    "effect": "catalog:",
    "weapon-regex": "~1.3.2"
  },
  "devDependencies": {
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@types/babel__core": "7.20.5",
    "@types/babel__generator": "7.27.0",
    "@types/estree": "1.0.8",
    "@types/node": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "svelte": "5.55.1",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "provenance": true,
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "inlinedDependencies": {
    "@jridgewell/gen-mapping": "0.3.13",
    "@jridgewell/remapping": "2.3.5",
    "@jridgewell/resolve-uri": "3.1.2",
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@sveltejs/acorn-typescript": "1.0.13",
    "acorn": "8.18.0",
    "aria-query": "5.3.1",
    "axobject-query": "4.1.0",
    "esrap": "2.3.6",
    "is-reference": "3.0.3",
    "locate-character": "3.0.0",
    "magic-string": "0.30.21",
    "svelte": "5.55.1",
    "zimmerframe": "1.1.4"
  }
