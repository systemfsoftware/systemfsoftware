{
  "name": "@systemfsoftware/stryker-js-platform-node",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/testing/mutation/stryker-js/platform-node"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/testing/mutation/stryker-js/platform-node#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Node host for the @systemfsoftware mutation engine — inert Layer, workers as files.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "build": "tsdown",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint --format=${f:-default}",
    "attw": "attw --pack .",
    "mutation": "NODE_OPTIONS=--max-old-space-size=8192 stryker run",
    "mutation:full": "NODE_OPTIONS=--max-old-space-size=8192 stryker run --force"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@noble/hashes": "1.8.0",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/stryker-js": "workspace:^",
    "@systemfsoftware/stryker-js-instrumenter": "workspace:^",
    "diff-match-patch": "1.0.5",
    "minimatch": "~10.2.4",
    "mutation-testing-report-schema": "3.7.3"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@std/jsonc": "catalog:",
    "@systemfsoftware/all": "workspace:^",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/stryker-plugins": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/diff-match-patch": "1.0.36",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.mjs",
      "./config/base": "./dist/config/base.mjs",
      "./internal/checker-worker": "./dist/internal/checker-worker.mjs",
      "./internal/child-process-proxy-worker-main": "./dist/internal/child-process-proxy-worker-main.mjs",
      "./internal/child-process-test-runner-worker": "./dist/internal/child-process-test-runner-worker.mjs",
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./config/base": {
      "@systemfsoftware/source": "./src/config/base.ts",
      "default": "./dist/config/base.mjs"
    },
    "./internal/checker-worker": {
      "@systemfsoftware/source": "./src/Checker.worker.ts",
      "default": "./dist/internal/checker-worker.mjs"
    },
    "./internal/child-process-proxy-worker-main": {
      "@systemfsoftware/source": "./src/WorkerMain.ts",
      "default": "./dist/internal/child-process-proxy-worker-main.mjs"
    },
    "./internal/child-process-test-runner-worker": {
      "@systemfsoftware/source": "./src/child-process-test-runner-worker.ts",
      "default": "./dist/internal/child-process-test-runner-worker.mjs"
    },
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "mutation-testing-metrics": "3.7.3"
  }
}
