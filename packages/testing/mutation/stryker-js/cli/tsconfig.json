{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@systemfsoftware/tsconfig/bundler/dom/library-monorepo", "@systemfsoftware/tsconfig/effect"],
  "compilerOptions": {
    "types": ["node"],
    // No `@systemfsoftware/source` condition: core is `strict: false`, so its
    // source in this program reports 374 errors. Add it when core is strict.
    "isolatedModules": true
  },
  "include": [
    "src",
    "test",
    "tests"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
