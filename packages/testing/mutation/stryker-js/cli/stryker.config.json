{
  "extends": "../../../../../stryker.config.base.json",
  "mutate": [
    "src/**/*.workflow.ts"
  ],
  "disableBail": true,
  "plugins": [
    "@systemfsoftware/stryker-js-vitest-runner"
  ],
  "reporters": [
    "progress",
    "json"
  ],
  "ignorePatterns": [
    "reports",
    "coverage",
    "dist"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "htmlReporter": null,
  "ignorers": [
    "effect-schema-declarations",
    "workflow-make-boundary"
  ]
}
