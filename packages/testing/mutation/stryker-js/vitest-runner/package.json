{
  "name": "@systemfsoftware/stryker-js-vitest-runner",
  "version": "2.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/testing/mutation/stryker-js/vitest-runner"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/testing/mutation/stryker-js/vitest-runner#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Vitest test-runner plugin for Stryker",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./stryker-setup": {
      "@systemfsoftware/source": "./src/stryker-setup.ts",
      "default": "./dist/stryker-setup.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "attw --pack .",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "surface:update": "api-surface generate ."
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "stryker",
    "vitest",
    "@systemfsoftware/stryker-js-test-runner-plugin"
  ],
  "initStrykerConfig": {
    "coverageAnalysis": "perTest"
  },
  "dependencies": {
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/stryker-js": "workspace:^"
  },
  "peerDependencies": {
    "effect": "catalog:peers",
    "vitest": ">=2.0.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@systemfsoftware/all": "workspace:^",
    "@systemfsoftware/api-surface": "workspace:^",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "provenance": true,
    "exports": {
      ".": "./dist/index.mjs",
      "./stryker-setup": "./dist/stryker-setup.mjs",
      "./package.json": "./package.json"
    }
  }
}
