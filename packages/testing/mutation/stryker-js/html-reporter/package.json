{
  "name": "@systemfsoftware/stryker-js-html-reporter",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/testing/mutation/stryker-js/html-reporter"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/testing/mutation/stryker-js/html-reporter#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "HTML reporter plugin for the @systemfsoftware mutation engine.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "attw": "attw --pack .",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint --format=${f:-default}"
  },
  "dependencies": {
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/stryker-js": "workspace:^",
    "mutation-testing-elements": "catalog:stryker",
    "mutation-testing-metrics": "catalog:stryker",
    "mutation-testing-report-schema": "catalog:stryker"
  },
  "devDependencies": {
    "@systemfsoftware/all": "workspace:^",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
