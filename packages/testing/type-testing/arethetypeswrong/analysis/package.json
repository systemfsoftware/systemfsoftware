{
  "name": "@systemfsoftware/arethetypeswrong",
  "version": "6.0.0",
  "description": "The API behind arethetypeswrong.github.io — owned and maintained by systemfsoftware",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/testing/type-testing/arethetypeswrong/analysis"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "npm_config_ignore_scripts=true attw --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "test": "vitest run",
    "test:run": "vitest run --coverage",
    "prepack": "pnpm build"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@loaderkit/resolve": "^1.0.2",
    "@systemfsoftware/npm-package": "workspace:^",
    "cjs-module-lexer": "^2.2.1",
    "effect": "catalog:",
    "semver": "^7.5.4",
    "typescript": "catalog:attw",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/arethetypeswrong-recipes": "workspace:^",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-memfs": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/semver": "^7.5.0",
    "@types/validate-npm-package-name": "^4.0.0",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
