{
  "name": "@systemfsoftware/storybook-gherkin",
  "license": "Apache-2.0",
  "version": "2.0.2",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/testing/specs/gherkin/storybook"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/testing/specs/gherkin/storybook#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Feature specs as Storybook stories — Gherkin Given/When/Then embedded in CSF with typed captures and scenario outlines, executing under Storybook's browser-mode play functions.",
  "keywords": [
    "effect",
    "effect-ts",
    "storybook",
    "gherkin",
    "bdd",
    "cucumber",
    "given-when-then",
    "scenario-outline",
    "stories",
    "csf",
    "acceptance-testing"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown && pnpm dts:check",
    "typecheck": "tsc --noEmit --incremental",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --config oxlint.config.ts --format=${f:-default}",
    "lint:tsgo": "effect-tsgo diagnostics --project tsconfig.json --format ${TSGO_FORMAT:-text}",
    "attw": "attw --pack .",
    "dts:check": "node scripts/check-dts.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "test:browser": "vitest run"
  },
  "dependencies": {
    "type-fest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers",
    "storybook": ">=10.0.0"
  },
  "devDependencies": {
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "storybook": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
