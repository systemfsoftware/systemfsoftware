{
  "name": "@systemfsoftware/effect-cell-types",
  "license": "Apache-2.0",
  "version": "1.0.1",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/effect-cell-types"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/effect-cell-types#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Type-level contracts for the repo's cell taxonomy, starting with the Workflow decision channel — a type-only package every effect kernel shares.",
  "keywords": [
    "effect",
    "effect-ts",
    "typescript",
    "architecture",
    "type-level",
    "workflow",
    "either"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/effect-cell-types.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown && pnpm api:check",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "lint": "oxlint . --format=${OXLINT_FORMAT:-default}",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/effect-cell-types.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
