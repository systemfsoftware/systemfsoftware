{
  "name": "@systemfsoftware/effect-schema-discovery",
  "license": "Apache-2.0",
  "version": "1.0.3",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/effect-schema-discovery"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/effect-schema-discovery#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Effect Schema source-discovery walk for the Vite law plugin.",
  "keywords": [
    "effect",
    "effect-ts",
    "schema",
    "discovery",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/effect-schema-discovery.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown && pnpm api:check && node ./pin-inhabitance.mjs",
    "typecheck": "tsc --noEmit --incremental",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "test": "vitest run"
  },
  "dependencies": {
    "@oxc-project/types": "catalog:",
    "oxc-parser": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/effect-schema-discovery.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
