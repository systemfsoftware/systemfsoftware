{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect/entrypoint"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.test.tsbuildinfo",
    "outDir": "node_modules/.cache/tsc/test",
    "types": [
      "node",
      "vitest/import-meta"
    ],
    "customConditions": [
      "@systemfsoftware/source"
    ]
  },
  "include": [
    "tests"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
