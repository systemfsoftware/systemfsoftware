{
  "name": "@systemfsoftware/rx-effect",
  "license": "MIT",
  "version": "0.3.4",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/rx-effect"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/rx-effect#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Bridge RxJS and Effect-TS — turn an Observable into a typed Effect Stream with backpressure and proper interruption.",
  "keywords": [
    "effect",
    "effect-ts",
    "rxjs",
    "observable",
    "stream",
    "reactive",
    "interop",
    "backpressure",
    "typescript"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/rx-effect.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:run": "vitest run",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}",
    "attw": "attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "rimraf": "catalog:",
    "rxjs": "^7.8.2",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "*",
    "rxjs": "^7"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/rx-effect.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
