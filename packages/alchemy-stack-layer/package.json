{
  "name": "@systemfsoftware/alchemy-stack-layer",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/alchemy-stack-layer"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/alchemy-stack-layer#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "An alchemy stack as a scoped Effect layer: deploys on acquire, destroys on release, and runs against the local Workers runtime or real Cloudflare by alchemy's own toggle.",
  "keywords": [
    "alchemy",
    "cloudflare",
    "effect",
    "effect-ts",
    "layer",
    "integration-testing",
    "gherkin",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run && vitest run --config vitest.toggle.config.ts",
    "test:cloud": "vitest run --config vitest.cloud.config.ts",
    "test:types": "TSTYCHE_TYPESCRIPT_MODULE=tstyche-typescript tstyche",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; effect-tsgo oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@alchemy.run/test": "catalog:",
    "@systemfsoftware/effect-spec-runtime": "workspace:^"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@effect/platform-node": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "tstyche": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:peers"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
