{
  "name": "@systemfsoftware/oxlint-plugin-effect-dmmf",
  "license": "Apache-2.0",
  "version": "3.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/lint/oxlint/plugins/meta/effect-dmmf"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/lint/oxlint/plugins/meta/effect-dmmf#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "One-shot oxlint plugin bundle: registers the surviving architecture rules in the DMMF family (property testing, test hygiene, test placement, effect-schema, effect-workflow) under a single entrypoint, excluding the core junk drawer.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "oxc",
    "lint",
    "linter",
    "lint-rules",
    "effect",
    "effect-ts",
    "dmmf",
    "workflow",
    "executor",
    "property-testing",
    "naming-convention",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/oxlint-plugin-effect-dmmf.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && pnpm api:check",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:oxlint",
    "@systemfsoftware/oxlint-plugin-effect-schema": "workspace:^",
    "@systemfsoftware/oxlint-plugin-effect-workflow": "workspace:^",
    "@systemfsoftware/oxlint-plugin-property-testing": "workspace:^",
    "@systemfsoftware/oxlint-plugin-test-hygiene": "workspace:^",
    "@systemfsoftware/oxlint-plugin-test-placement": "workspace:^"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/tsconfig": "workspace:^",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxlint": "catalog:oxlint"
  },
  "publishConfig": {
    "provenance": true
  }
}
