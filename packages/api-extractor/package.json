{
  "name": "@systemfsoftware/api-extractor",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/api-extractor"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/api-extractor#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "An API surface gate as a package: read an api-extractor.json, emit a byte-compatible *.api.md report and a valid .d.ts rollup, and print nothing on success under --quiet.",
  "keywords": [
    "api-extractor",
    "api-report",
    "dts-rollup",
    "declaration-bundling",
    "tsdoc",
    "typescript",
    "effect",
    "effect-ts"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "api-extractor": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "test:contract": "vitest run --config vitest.config.ts tests/*.contract.test.ts",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force",
    "smoke": "pnpm exec turbo run smoke:journey --filter=@systemfsoftware/api-extractor",
    "smoke:journey": "node examples/cli-journey.ts",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "node dist/main.mjs run --quiet",
    "api:update": "node dist/main.mjs run --local"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@microsoft/tsdoc": "~0.16.0",
    "@microsoft/tsdoc-config": "~0.18.1",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "diff": "~8.0.2",
    "effect": "catalog:",
    "minimatch": "10.2.3",
    "semver": "~7.7.4",
    "source-map": "~0.6.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.1",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/differential-spec": "workspace:^",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-memfs": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/stryker-config": "workspace:^",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:stryker",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "catalog:stryker",
    "@systemfsoftware/stryker-js": "catalog:stryker",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:stryker",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:stryker",
    "@systemfsoftware/stryker-test-contribution": "catalog:stryker",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "default": "./dist/mod.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
