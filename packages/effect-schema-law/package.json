{
  "name": "@systemfsoftware/effect-schema-law",
  "license": "Apache-2.0",
  "version": "2.2.1",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/effect-schema-law"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/effect-schema-law#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Property-test any Effect Schema's codec laws — round-trip identity and encode stability, generated with @effect/vitest and fast-check.",
  "keywords": [
    "effect",
    "effect-ts",
    "schema",
    "codec",
    "property-testing",
    "fast-check",
    "vitest",
    "roundtrip",
    "law-testing",
    "validation",
    "serialization",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/effect-schema-law.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/all": "workspace:^",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-schema-recursion-budget": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/vitest": "catalog:peers",
    "effect": "catalog:peers",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/effect-schema-law.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
