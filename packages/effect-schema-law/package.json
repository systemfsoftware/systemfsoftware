{
  "name": "@systemfsoftware/effect-schema-law",
  "license": "MIT",
  "version": "0.2.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/effect-schema-law"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/effect-schema-law#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Property-test the codec laws of any Effect Schema in one call — decode/encode round-trip identity and encode stability, generated with @effect/vitest and fast-check.",
  "keywords": [
    "effect",
    "effect-ts",
    "schema",
    "codec",
    "property-testing",
    "fast-check",
    "vitest",
    "roundtrip",
    "law-testing",
    "serialization",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/effect-schema-law.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:run": "vitest run",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "workspace:^"
  },
  "peerDependencies": {
    "@effect/vitest": "*",
    "effect": "*",
    "vitest": "*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/effect-schema-law.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
