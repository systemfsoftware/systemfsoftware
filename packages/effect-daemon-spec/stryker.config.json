{
  "extends": "../../../../stryker.config.base.json",
  "mutate": [
    "src/**/*.workflow.ts",
    "!src/**/*.test.ts",
    "!src/**/*.property.test.ts",
    "!src/**/*.d.ts",
    "!src/**/__tests__/**"
  ],
  "plugins": [
    "@systemfsoftware/stryker-js-vitest-runner",
    "@systemfsoftware/stryker-js-typescript-checker",
    "@systemfsoftware/stryker-plugins/in-source-test-ignorer"
  ],
  "ignorers": [
    "effect-schema-declarations",
    "in-source-vitest-block",
    "workflow-make-boundary"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "dryRunTimeoutMinutes": 10,
  "disableBail": true,
  "ignorePatterns": null
}
