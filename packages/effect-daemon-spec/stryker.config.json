{
  "extends": "@systemfsoftware/stryker-js-mutation-run/config/base",
  "mutate": [
    "src/**/*.workflow.ts",
    "src/**/*.schema.ts"
  ],
  "plugins": [
    "@systemfsoftware/stryker-js-vitest-runner",
    "@systemfsoftware/stryker-js-typescript-checker",
    "@systemfsoftware/stryker-plugins"
  ],
  "ignorers": [
    "effect-schema-declarations",
    "in-source-vitest-block"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "dryRunTimeoutMinutes": 10,
  "disableBail": true,
  "ignorePatterns": null
}
