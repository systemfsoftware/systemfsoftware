{
  "role": "schema",
  "namespace": "Schema",
  "imports": [
    { "module": "effect", "values": ["Schema"] },
    { "module": "../supervisor-dynamic.kernel.js", "values": ["MAX_CHILDREN_CEILING"] },
    { "module": "./restart-decision.kernel.js", "values": ["failedIndexAddressesAChild"] }
  ],
  "declarations": [
    {
      "kind": "schema",
      "name": "RestartStrategy",
      "value": { "literal": ["one_for_one", "one_for_all", "rest_for_one"] },
      "typeAlias": { "form": "Type" }
    },
    {
      "kind": "schema",
      "name": "DecideInput",
      "value": {
        "pipe": [
          {
            "struct": {
              "strategy": { "name": "RestartStrategy" },
              "totalChildren": {
                "pipe": [{ "ref": "Int" }, { "between": [{ "value": 1 }, { "name": "MAX_CHILDREN_CEILING" }] }]
              },
              "failedIndex": {
                "pipe": [{ "ref": "Int" }, { "between": [{ "value": 0 }, { "name": "MAX_CHILDREN_CEILING" }] }]
              },
              "exitSuccess": { "ref": "Boolean" },
              "intensityExceeded": { "ref": "Boolean" }
            }
          },
          {
            "filter": {
              "by": "failedIndexAddressesAChild",
              "message": "failedIndex must be < totalChildren"
            }
          }
        ]
      },
      "typeAlias": { "form": "Type" }
    }
  ]
}
