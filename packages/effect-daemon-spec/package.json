{
  "name": "@systemfsoftware/effect-daemon-spec",
  "license": "MIT",
  "version": "0.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/effect-daemon-spec"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/effect-daemon-spec#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Supervision-tree daemons for Effect-TS — leader election, distributed locks, restart-intensity backoff, dynamic children, and health latches as a pure typed core.",
  "keywords": [
    "effect",
    "effect-ts",
    "daemon",
    "supervisor",
    "supervision-tree",
    "leader-election",
    "distributed-lock",
    "restart",
    "backoff",
    "fault-tolerance",
    "actor",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/effect-daemon-spec.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:run": "vitest run",
    "mutation": "stryker run --incremental",
    "mutation:full": "stryker run",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "devDependencies": {
    "@effect/vitest": "0.29.0",
    "@microsoft/api-extractor": "^7.58.7",
    "@systemfsoftware/stryker-js-core": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "workspace:^",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/stryker-plugins": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "effect": "^3.22.0",
    "fast-check": "^3",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.9",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4"
  },
  "peerDependencies": {
    "effect": "*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/effect-daemon-spec.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
