{
  "name": "@systemfsoftware/effect-daemon-spec",
  "license": "Apache-2.0",
  "version": "0.7.2",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/effect-daemon-spec"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/effect-daemon-spec#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Supervision-tree daemons for Effect-TS — leader election, distributed locks, restart-intensity backoff, dynamic children, and health latches as a pure typed core.",
  "keywords": [
    "effect",
    "effect-ts",
    "daemon",
    "supervisor",
    "supervision-tree",
    "leader-election",
    "distributed-lock",
    "restart",
    "backoff",
    "fault-tolerance",
    "actor",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/effect-daemon-spec.d.ts",
      "default": "./dist/index.mjs"
    },
    "./DaemonReporter": {
      "@systemfsoftware/source": "./src/daemon-reporter/mod.ts",
      "types": "./dist/DaemonReporter.rollup.d.ts",
      "default": "./dist/DaemonReporter.mjs"
    },
    "./DaemonSpec": {
      "@systemfsoftware/source": "./src/daemon-spec/mod.ts",
      "types": "./dist/DaemonSpec.rollup.d.ts",
      "default": "./dist/DaemonSpec.mjs"
    },
    "./LeaderLock": {
      "@systemfsoftware/source": "./src/leader-lock/mod.ts",
      "types": "./dist/LeaderLock.rollup.d.ts",
      "default": "./dist/LeaderLock.mjs"
    },
    "./SupervisionPolicy": {
      "@systemfsoftware/source": "./src/supervision-policy/mod.ts",
      "types": "./dist/SupervisionPolicy.rollup.d.ts",
      "default": "./dist/SupervisionPolicy.mjs"
    },
    "./package.json": "./package.json",
    "./internal/*": null
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown && pnpm api:check",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:run": "vitest run",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}",
    "api:check": "api-extractor run && api-extractor run --config api-extractor.SupervisionPolicy.json && api-extractor run --config api-extractor.LeaderLock.json && api-extractor run --config api-extractor.DaemonReporter.json && api-extractor run --config api-extractor.DaemonSpec.json",
    "api:update": "api-extractor run --local && api-extractor run --local --config api-extractor.SupervisionPolicy.json && api-extractor run --local --config api-extractor.LeaderLock.json && api-extractor run --local --config api-extractor.DaemonReporter.json && api-extractor run --local --config api-extractor.DaemonSpec.json",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "^7.58.7",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/stryker-js-mutation-run": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "workspace:^",
    "@systemfsoftware/stryker-js-vitest-runner": "workspace:^",
    "@systemfsoftware/stryker-plugins": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/effect-daemon-spec.d.ts",
        "default": "./dist/index.mjs"
      },
      "./DaemonReporter": {
        "types": "./dist/DaemonReporter.rollup.d.ts",
        "default": "./dist/DaemonReporter.mjs"
      },
      "./DaemonSpec": {
        "types": "./dist/DaemonSpec.rollup.d.ts",
        "default": "./dist/DaemonSpec.mjs"
      },
      "./LeaderLock": {
        "types": "./dist/LeaderLock.rollup.d.ts",
        "default": "./dist/LeaderLock.mjs"
      },
      "./SupervisionPolicy": {
        "types": "./dist/SupervisionPolicy.rollup.d.ts",
        "default": "./dist/SupervisionPolicy.mjs"
      },
      "./package.json": "./package.json",
      "./internal/*": null
    },
    "provenance": true
  }
}
