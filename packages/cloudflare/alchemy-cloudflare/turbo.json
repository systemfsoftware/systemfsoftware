{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": [
        "openapi/**",
        "package.json"
      ],
      "outputs": [
        "src/api/cloudflare-api.ts"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "build",
        "generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "build",
        "generate"
      ]
    }
  }
}
