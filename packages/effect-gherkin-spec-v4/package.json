{
  "name": "@systemfsoftware/effect-gherkin-spec-v4",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.5.1",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/effect-gherkin-spec-v4"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/effect-gherkin-spec-v4#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Gherkin BDD for Effect-TS and Vitest — Given/When/Then steps that compose as Effects, with Scenario Outline expansion and typed step errors.",
  "keywords": [
    "effect",
    "effect-ts",
    "vitest",
    "gherkin",
    "bdd",
    "cucumber",
    "given-when-then",
    "scenario-outline",
    "acceptance-testing",
    "property-testing",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:run": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect-v4",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:effect-v4",
    "fast-check": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@effect/vitest": "catalog:effect-v4",
    "effect": "catalog:effect-v4",
    "vitest": ">=4.1.0 <5.0.0"
  }
}
