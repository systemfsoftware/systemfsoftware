{
  "name": "@systemfsoftware/xstate-test",
  "license": "MIT",
  "version": "2.0.0-alpha.1",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/xstate/xstate-test"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/xstate/xstate-test#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Model-based testing for XState machines — forked under systemfsoftware from statelyai/xstate (@xstate/test at 2146ae26).",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint:tsgo": "effect-tsgo diagnostics --project tsconfig.app.json --format ${TSGO_FORMAT:-text}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run && api-extractor-quiet run --config api-extractor.effect-schema.json && api-extractor-quiet run --config api-extractor.playwright.json && api-extractor-quiet run --config api-extractor.schema.json && api-extractor-quiet run --config api-extractor.vitest.json",
    "api:update": "api-extractor run --local && api-extractor run --local --config api-extractor.effect-schema.json && api-extractor run --local --config api-extractor.playwright.json && api-extractor run --local --config api-extractor.schema.json && api-extractor run --local --config api-extractor.vitest.json"
  },
  "peerDependencies": {
    "@systemfsoftware/xstate": "workspace:^",
    "effect": "catalog:peers",
    "fast-check": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@playwright/test": "1.63.0",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@systemfsoftware/xstate": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./effect-schema": {
        "types": "./dist/effect-schema.d.ts",
        "default": "./dist/effect-schema.mjs"
      },
      "./playwright": {
        "types": "./dist/playwright.d.ts",
        "default": "./dist/playwright.mjs"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.mjs"
      },
      "./vitest": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./effect-schema": {
      "@systemfsoftware/source": "./src/effect-schema.ts",
      "types": "./dist/effect-schema.d.ts",
      "default": "./dist/effect-schema.mjs"
    },
    "./playwright": {
      "@systemfsoftware/source": "./src/playwright.ts",
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.mjs"
    },
    "./schema": {
      "@systemfsoftware/source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.mjs"
    },
    "./vitest": {
      "@systemfsoftware/source": "./src/vitest.ts",
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.mjs"
    },
    "./package.json": "./package.json"
  }
}
