{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/dom/library-monorepo"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.test.tsbuildinfo",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc/test"
  },
  "include": [
    "test",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "exclude": [
    "src/select.test.ts",
    "test/atom.port.test.ts",
    "test/broadcast.test.ts",
    "test/fromStore.test.ts",
    "test/persist.test.ts",
    "test/reset.test.ts",
    "test/store.test.ts",
    "test/types.test.tsx",
    "test/undo.test.ts",
    "test/validate.test.ts"
  ]
}
