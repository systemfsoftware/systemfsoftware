{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "esnext",
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "module": "preserve",
    "allowImportingTsExtensions": true,
    "noEmit": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": [
      "es2024",
      "dom"
    ],
    "strict": true,
    "stripInternal": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc/upstream-test",
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.upstream-test.tsbuildinfo",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "paths": {
      "@xstate/effect": [
        "../xstate-effect/src/index.ts"
      ],
      "@xstate/effect/atom": [
        "../xstate-effect/src/atom.ts"
      ],
      "@xstate/react": [
        "../xstate-react/src/index.ts"
      ],
      "@xstate/store": [
        "./src/index.ts"
      ],
      "@xstate/store-react": [
        "../xstate-store-react/src/index.ts"
      ],
      "@xstate/store/persist": [
        "./src/persist.ts"
      ],
      "@xstate/store/reset": [
        "./src/reset.ts"
      ],
      "@xstate/store/undo": [
        "./src/undo.ts"
      ],
      "@xstate/store/validate": [
        "./src/validate.ts"
      ],
      "@xstate/test": [
        "../xstate-test/src/index.ts"
      ],
      "@xstate/test/effect-schema": [
        "../xstate-test/src/effect-schema.ts"
      ],
      "@xstate/test/playwright": [
        "../xstate-test/src/playwright.ts"
      ],
      "@xstate/test/schema": [
        "../xstate-test/src/schema.ts"
      ],
      "@xstate/test/vitest": [
        "../xstate-test/src/vitest.ts"
      ],
      "xstate": [
        "../xstate/src/index.ts"
      ],
      "xstate/actors": [
        "../xstate/src/actors/index.ts"
      ],
      "xstate/durable": [
        "../xstate/src/durable/index.ts"
      ],
      "xstate/fsm": [
        "../xstate/src/fsm/index.ts"
      ],
      "xstate/graph": [
        "../xstate/src/graph/index.ts"
      ],
      "xstate/validation": [
        "../xstate/src/validation/index.ts"
      ]
    }
  },
  "include": [
    "src/select.test.ts",
    "test/atom.port.test.ts",
    "test/broadcast.test.ts",
    "test/fromStore.test.ts",
    "test/persist.test.ts",
    "test/reset.test.ts",
    "test/store.test.ts",
    "test/types.test.tsx",
    "test/undo.test.ts",
    "test/validate.test.ts"
  ],
  "references": [
    {
      "path": "../xstate-effect/tsconfig.app.json"
    },
    {
      "path": "../xstate-react/tsconfig.app.json"
    },
    {
      "path": "../xstate-store-react/tsconfig.app.json"
    },
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "../xstate-test/tsconfig.app.json"
    },
    {
      "path": "../xstate/tsconfig.app.json"
    }
  ]
}
