{
  "name": "@systemfsoftware/xstate",
  "license": "MIT",
  "version": "6.0.0-alpha.64",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/xstate/xstate"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/xstate/xstate#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Statecharts and actors for TypeScript, as pure machine definitions and transitions — forked under systemfsoftware from statelyai/xstate (xstate at 2146ae26).",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint:tsgo": "effect-tsgo diagnostics --project tsconfig.app.json --format ${TSGO_FORMAT:-text} && effect-tsgo diagnostics --project tsconfig.test.json --format ${TSGO_FORMAT:-text}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run && api-extractor-quiet run --config api-extractor.actors.json && api-extractor-quiet run --config api-extractor.durable.json && api-extractor-quiet run --config api-extractor.fsm.json && api-extractor-quiet run --config api-extractor.graph.json && api-extractor-quiet run --config api-extractor.validation.json",
    "api:update": "api-extractor run --local && api-extractor run --local --config api-extractor.actors.json && api-extractor run --local --config api-extractor.durable.json && api-extractor run --local --config api-extractor.fsm.json && api-extractor run --local --config api-extractor.graph.json && api-extractor run --local --config api-extractor.validation.json"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "ajv": "8.20.0",
    "effect": "catalog:",
    "rimraf": "catalog:",
    "rxjs": "7.8.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "3.25.76"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./actors": {
        "types": "./dist/actors.d.ts",
        "default": "./dist/actors.mjs"
      },
      "./durable": {
        "types": "./dist/durable.d.ts",
        "default": "./dist/durable.mjs"
      },
      "./fsm": {
        "types": "./dist/fsm.d.ts",
        "default": "./dist/fsm.mjs"
      },
      "./graph": {
        "types": "./dist/graph.d.ts",
        "default": "./dist/graph.mjs"
      },
      "./validation": {
        "types": "./dist/validation.d.ts",
        "default": "./dist/validation.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "imports": {
    "#is-development": {
      "development": "./src/true.ts",
      "default": "./src/false.ts"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./actors": {
      "@systemfsoftware/source": "./src/actors/index.ts",
      "types": "./dist/actors.d.ts",
      "default": "./dist/actors.mjs"
    },
    "./durable": {
      "@systemfsoftware/source": "./src/durable/index.ts",
      "types": "./dist/durable.d.ts",
      "default": "./dist/durable.mjs"
    },
    "./fsm": {
      "@systemfsoftware/source": "./src/fsm/index.ts",
      "types": "./dist/fsm.d.ts",
      "default": "./dist/fsm.mjs"
    },
    "./graph": {
      "@systemfsoftware/source": "./src/graph/index.ts",
      "types": "./dist/graph.d.ts",
      "default": "./dist/graph.mjs"
    },
    "./validation": {
      "@systemfsoftware/source": "./src/validation/index.ts",
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.mjs"
    },
    "./package.json": "./package.json"
  }
}
