{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect/entrypoint"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.test.tsbuildinfo",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc/test"
  },
  "include": [
    "test",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "exclude": [
    "src/actor.test.ts",
    "src/atom.test.ts",
    "src/index.test.ts",
    "src/persistence.test.ts",
    "src/requirements.types.test.ts",
    "src/runtime.test.ts",
    "src/state.test.ts"
  ]
}
