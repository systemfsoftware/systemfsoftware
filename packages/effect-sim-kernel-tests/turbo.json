{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // The kernel reads Effect's runtime internals, so an Effect bump or patch in the lockfile re-runs this suite.
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.ts",
        "vitest.config.*",
        "$TURBO_ROOT$/packages/toolchain/vitest-config/lib/**",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CHANGELOG.md"
      ]
    }
  }
}
