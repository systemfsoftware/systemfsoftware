{
  "name": "@systemfsoftware/npm-package",
  "version": "0.2.2",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/npm-package"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/npm-package#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "An npm package as an in-memory file tree: build one from an authored file map, pack it to tarball bytes, and read one back — without touching the filesystem.",
  "keywords": [
    "npm",
    "package",
    "tarball",
    "pack",
    "in-memory",
    "virtual-filesystem",
    "ustar",
    "gzip",
    "effect",
    "effect-ts",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "attw --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@andrewbranch/untar.js": "^1.0.3",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-memfs": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
