{
  "name": "@systemfsoftware/agent-front-door",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/contract/agent-front-door"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/contract/agent-front-door#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "The agent front door: one fetch handler over the contract surfaces, and the Dynamic Worker sandbox host that runs agent programs inside an egress allow-list.",
  "keywords": [
    "effect",
    "effect-ts",
    "agent",
    "sandbox",
    "dynamic-worker",
    "workerd",
    "front-door"
  ],
  "type": "module",
  "sideEffects": [],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "test:types": "TSTYCHE_TYPESCRIPT_MODULE=tstyche-typescript tstyche",
    "mutation": "stryker run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run && api-extractor-quiet run --config src/surfaces/sandbox/api-extractor.json && api-extractor-quiet run --config src/operations/api-extractor.json",
    "api:update": "api-extractor run --local && api-extractor run --local --config src/surfaces/sandbox/api-extractor.json && api-extractor run --local --config src/operations/api-extractor.json"
  },
  "dependencies": {
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/effect-contract": "workspace:^",
    "fast-check": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/effect-workerd-harness": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/stryker-config": "workspace:^",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:stryker",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "catalog:stryker",
    "@systemfsoftware/stryker-js": "catalog:stryker",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:stryker",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:stryker",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "miniflare": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "tstyche": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./operations": {
        "types": "./dist/operations.d.ts",
        "default": "./dist/operations.mjs"
      },
      "./sandbox": {
        "types": "./dist/sandbox.d.ts",
        "default": "./dist/sandbox.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./operations": {
      "@systemfsoftware/source": "./src/operations/mod.ts",
      "types": "./dist/operations.d.ts",
      "default": "./dist/operations.mjs"
    },
    "./sandbox": {
      "@systemfsoftware/source": "./src/surfaces/sandbox/mod.ts",
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.mjs"
    },
    "./package.json": "./package.json"
  }
}
