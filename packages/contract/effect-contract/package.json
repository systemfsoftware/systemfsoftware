{
  "name": "@systemfsoftware/effect-contract",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/contract/effect-contract"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/contract/effect-contract#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "One Effect Schema contract and one Cell per capability, with a closed answer census every surface projects the same way.",
  "keywords": [
    "effect",
    "effect-ts",
    "contract",
    "capability",
    "openapi",
    "mcp",
    "rpc"
  ],
  "type": "module",
  "sideEffects": [],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "test:types": "TSTYCHE_TYPESCRIPT_MODULE=tstyche-typescript tstyche",
    "mutation": "stryker run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run && api-extractor-quiet run --config src/surfaces/http/api-extractor.json && api-extractor-quiet run --config src/surfaces/cli/api-extractor.json && api-extractor-quiet run --config src/surfaces/mcp/api-extractor.json && api-extractor-quiet run --config src/surfaces/code-mode/api-extractor.json",
    "api:update": "api-extractor run --local && api-extractor run --local --config src/surfaces/http/api-extractor.json && api-extractor run --local --config src/surfaces/cli/api-extractor.json && api-extractor run --local --config src/surfaces/mcp/api-extractor.json && api-extractor run --local --config src/surfaces/code-mode/api-extractor.json"
  },
  "dependencies": {
    "@systemfsoftware/differential-spec": "workspace:^",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "fast-check": "catalog:",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/stryker-config": "workspace:^",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:stryker",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "catalog:stryker",
    "@systemfsoftware/stryker-js": "catalog:stryker",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:stryker",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:stryker",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "tstyche": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@systemfsoftware/vitest": "workspace:^",
    "effect": "catalog:peers",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.mjs"
      },
      "./code-mode": {
        "types": "./dist/code-mode.d.ts",
        "default": "./dist/code-mode.mjs"
      },
      "./http": {
        "types": "./dist/http.d.ts",
        "default": "./dist/http.mjs"
      },
      "./mcp": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.mjs"
      },
      "./rpc": {
        "types": "./dist/rpc.d.ts",
        "default": "./dist/rpc.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./cli": {
      "@systemfsoftware/source": "./src/surfaces/cli/mod.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.mjs"
    },
    "./code-mode": {
      "@systemfsoftware/source": "./src/surfaces/code-mode/mod.ts",
      "types": "./dist/code-mode.d.ts",
      "default": "./dist/code-mode.mjs"
    },
    "./http": {
      "@systemfsoftware/source": "./src/surfaces/http/mod.ts",
      "types": "./dist/http.d.ts",
      "default": "./dist/http.mjs"
    },
    "./mcp": {
      "@systemfsoftware/source": "./src/surfaces/mcp/mod.ts",
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.mjs"
    },
    "./rpc": {
      "@systemfsoftware/source": "./src/surfaces/rpc/mod.ts",
      "types": "./dist/rpc.d.ts",
      "default": "./dist/rpc.mjs"
    },
    "./testing": {
      "@systemfsoftware/source": "./src/testing/mod.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.mjs"
    },
    "./package.json": "./package.json"
  }
}
