{
  "name": "@systemfsoftware/tsconfig",
  "license": "Apache-2.0",
  "version": "2.0.1",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "description": "Shared TypeScript base configs and the two Effect Language Service role presets for the System F Software monorepo — 2026-tuned (es2024, esnext, full strict set) plus the tsgo diagnostics every role lists at error.",
  "type": "module",
  "files": [
    "tsc",
    "bundler",
    "node.json",
    "effect.json",
    "effect-entrypoint.json",
    "opt-ins.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./node": "./node.json",
    "./effect": "./effect.json",
    "./effect/entrypoint": "./effect-entrypoint.json",
    "./opt-ins.json": "./opt-ins.json",
    "./tsc": "./tsc/dom/app.json",
    "./tsc/dom": "./tsc/dom/app.json",
    "./tsc/dom/app": "./tsc/dom/app.json",
    "./tsc/dom/library": "./tsc/dom/library.json",
    "./tsc/dom/library-monorepo": "./tsc/dom/library-monorepo.json",
    "./tsc/no-dom": "./tsc/no-dom/app.json",
    "./tsc/no-dom/app": "./tsc/no-dom/app.json",
    "./tsc/no-dom/library": "./tsc/no-dom/library.json",
    "./tsc/no-dom/library-monorepo": "./tsc/no-dom/library-monorepo.json",
    "./bundler": "./bundler/dom.json",
    "./bundler/dom": "./bundler/dom.json",
    "./bundler/dom/app": "./bundler/dom.json",
    "./bundler/dom/library": "./bundler/dom.json",
    "./bundler/dom/library-monorepo": "./bundler/dom.json",
    "./bundler/no-dom": "./bundler/no-dom.json",
    "./bundler/no-dom/app": "./bundler/no-dom.json",
    "./bundler/no-dom/library": "./bundler/no-dom.json",
    "./bundler/no-dom/library-monorepo": "./bundler/no-dom.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/toolchain/tsconfig"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "render": "tsx scripts/render.ts",
    "test": "tsx scripts/render.ts --check",
    "typecheck": "tsc -b",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@std/jsonc": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "tsx": "catalog:"
  }
}
