{
  "name": "@systemfsoftware/tsdown-config",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./eager-entry-budget": {
      "types": "./src/eager-entry-budget.d.mts",
      "default": "./src/eager-entry-budget.mjs"
    },
    "./quiet-build": {
      "types": "./src/quiet-build.d.ts",
      "default": "./src/quiet-build.js"
    }
  },
  "bin": {
    "api-extractor-quiet": "./src/api-extractor-quiet.js"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "attw": "attw --pack ."
  },
  "peerDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependenciesMeta": {
    "@microsoft/api-extractor": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/toolchain/tsdown-config"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/toolchain/tsdown-config#readme"
}
