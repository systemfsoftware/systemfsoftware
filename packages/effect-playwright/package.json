{
  "name": "@systemfsoftware/effect-playwright",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "packages/effect-playwright"
  },
  "homepage": "https://github.com/systemfsoftware/systemfsoftware/tree/main/packages/effect-playwright#readme",
  "bugs": "https://github.com/systemfsoftware/systemfsoftware/issues",
  "description": "Effect-native Playwright driver, forked from Jobflow-io/effect-playwright.",
  "keywords": [
    "effect",
    "playwright",
    "browser",
    "automation",
    "e2e"
  ],
  "type": "module",
  "bin": {
    "effect-playwright": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./experimental": {
      "@systemfsoftware/source": "./src/experimental/index.ts",
      "types": "./dist/experimental/index.d.ts",
      "default": "./dist/experimental/index.mjs"
    },
    "./test": {
      "@systemfsoftware/source": "./src/test.ts",
      "types": "./dist/test.d.ts",
      "default": "./dist/test.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown -l warn && pnpm api:check",
    "clean": "rimraf dist",
    "typecheck": "tsc -b",
    "test": "vitest run && playwright test --config e2e/playwright.config.ts",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run && api-extractor-quiet run --config api-extractor.experimental.json && api-extractor-quiet run --config api-extractor.test.json",
    "api:update": "api-extractor run --local && api-extractor run --local --config api-extractor.experimental.json && api-extractor run --local --config api-extractor.test.json"
  },
  "dependencies": {
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@playwright/test": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "playwright": "1.63.0",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": "catalog:",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./experimental": {
        "types": "./dist/experimental/index.d.ts",
        "default": "./dist/experimental/index.mjs"
      },
      "./test": {
        "types": "./dist/test.d.ts",
        "default": "./dist/test.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
