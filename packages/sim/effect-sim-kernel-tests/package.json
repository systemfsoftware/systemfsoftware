{
  "name": "@systemfsoftware/effect-sim-kernel-tests",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Private behaviour suite for @systemfsoftware/effect-sim-kernel. It lives outside the kernel because the Gherkin runner it is written in runs on the kernel.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}"
  },
  "devDependencies": {
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-sim-kernel": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/vitest": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
