#!/usr/bin/env sh
# Gate: refuse when HEAD lacks remote main as ancestor.
# Local main can lag — query the remote tip directly.
set -e
remote=origin

main_sha=$(git ls-remote --heads "$remote" main 2>/dev/null | cut -f1)
if [ -z "$main_sha" ]; then
  exit 0
fi

if ! git cat-file -e "$main_sha^{commit}" 2>/dev/null; then
  git fetch --quiet "$remote" main || {
    echo "pre-push: could not fetch $remote main." >&2
    exit 1
  }
fi

if ! git merge-base --is-ancestor "$main_sha" HEAD; then
  echo "pre-push: behind remote main ($main_sha)." >&2
  echo "Fetch and rebase onto $remote/main before pushing." >&2
  exit 1
fi
