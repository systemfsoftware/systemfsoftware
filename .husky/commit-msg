#!/usr/bin/env bash
set -e
# Subtree merge commits stage only repos/ paths, and the registration commit
# stages only subtrees.toml; commitlint's pnpm bootstrap cannot run against
# the vendored subtree state, so skip lint for both (git-subtree-vendor G23).
if git diff --cached --name-only | grep -qvE '^(repos/|subtrees\.toml)$'; then
  pnpm exec commitlint --edit "$1"
fi
