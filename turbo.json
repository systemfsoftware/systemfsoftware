{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "globalDependencies": [
    "scripts/tools/patch-tsgo-if-needed.mjs"
  ],
  "globalPassThroughEnv": [
    "XDG_CACHE_HOME",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "build": {
      "outputLogs": "new-only",
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsconfig.*.json",
        "package.json",
        "tsdown.config.*",
        "api-extractor.json",
        "api-extractor.*.json",
        "etc/*.api.md"
      ],
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/*.json",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/bundler/**",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/tsc/**",
        "!**/*.md"
      ],
      "outputs": [],
      "dependsOn": [
        "^build",
        "build"
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.ts",
        "vitest.config.*",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "$TURBO_ROOT$/packages/toolchain/vitest-config/lib/**",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CHANGELOG.md",
        "!**/etc/*.api.md"
      ],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "build",
        "api:check"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "NODE_ENV",
        "CI",
        "AGENT",
        "COVERAGE"
      ],
      "cache": true
    },
    "test:contract": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.contract.config.ts",
        "__tests__/**"
      ],
      "outputLogs": "new-only",
      "dependsOn": [
        "^build",
        "build"
      ],
      "outputs": [],
      "env": [
        "CI",
        "DOCKER_HOST",
        "TESTCONTAINERS_RYUK_DISABLED"
      ],
      "cache": false
    },
    "test:types": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "tstyche.json",
        "test-types/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/*.json",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/bundler/**",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/tsc/**",
        "!**/*.md"
      ],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "build"
      ],
      "outputs": [],
      "cache": true
    },
    "mutation": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "stryker.config.json",
        "$TURBO_ROOT$/stryker.config.base.json",
        "vitest.config.ts",
        "vitest.setup.ts",
        "reports/stryker-incremental.json",
        "$TURBO_ROOT$/packages/stryker-js/**",
        "!**/*.md"
      ],
      "outputs": [
        "reports/mutation-report.html",
        "reports/mutation-report.json"
      ],
      "env": [
        "NODE_ENV",
        "CI",
        "AGENT"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "oxlint.config.ts",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/packages/oxlint-plugin/oxlint-config/src/**",
        "$TURBO_ROOT$/packages/oxlint-plugin/oxlint-config/package.json",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/*.json",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/bundler/**",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/tsc/**",
        "!**/*.md"
      ],
      "outputs": [],
      "dependsOn": [
        "^build",
        "build"
      ],
      "env": [
        "NODE_ENV",
        "GITHUB_ACTIONS",
        "OXLINT_FORMAT",
        "AGENT"
      ],
      "cache": true
    },
    "lint:tsgo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/*.json",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/bundler/**",
        "$TURBO_ROOT$/packages/toolchain/tsconfig/tsc/**",
        "!**/*.md"
      ],
      "outputs": [],
      "env": [
        "TSGO_FORMAT"
      ],
      "cache": true
    },
    "api:check": {
      "outputLogs": "errors-only",
      "inputs": [
        "src/**",
        "api-extractor.json",
        "api-extractor.*.json",
        "tsconfig.build.json",
        "tsconfig.*.json",
        "etc/*.api.md"
      ],
      "outputs": [
        "dist/*.d.ts",
        "etc/*.api.md",
        "temp/**"
      ],
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "cache": false
    },
    "attw": {
      "outputLogs": "errors-only",
      "inputs": [
        "dist/**",
        "package.json"
      ],
      "dependsOn": [
        "build",
        "api:check"
      ]
    }
  }
}
