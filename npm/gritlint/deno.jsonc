{
  // Deno owns this directory's TypeScript: the launcher's behaviour test runs on
  // `deno test`, which is why `npm/gritlint/launcher.test.ts` needs no tsconfig.
  "nodeModulesDir": "none",
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.6",
  },
  "publish": {
    "exclude": ["**"],
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run",
  },
}
