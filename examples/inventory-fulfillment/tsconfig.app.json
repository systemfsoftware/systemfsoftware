{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/bundler/dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.app.tsbuildinfo",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "isolatedModules": true,
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "paths": {
      "#root/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
