{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/bundler/dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect/entrypoint"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.test.tsbuildinfo",
    "types": [
      "node"
    ],
    "isolatedModules": true,
    "customConditions": [
      "@systemfsoftware/source"
    ]
  },
  "include": [
    "tests",
    "scripts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
