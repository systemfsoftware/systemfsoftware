{
  "name": "@systemfsoftware/example-inventory-fulfillment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "example-inventory-fulfillment": "./src/main.ts"
  },
  "scripts": {
    "build": "tsdown -l warn",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:types": "TSTYCHE_TYPESCRIPT_MODULE=tstyche-typescript tstyche",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "@systemfsoftware/trace-taxonomy": "workspace:^",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@systemfsoftware/conformance-spec": "workspace:^",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/trace-spec": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "pg": "catalog:",
    "tsdown": "catalog:",
    "tstyche": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "inlinedDependencies": {
    "pg": "8.23.0",
    "pg-cloudflare": "1.4.0",
    "pg-connection-string": "2.14.0",
    "pg-int8": "1.0.1",
    "pg-pool": "3.14.0",
    "pg-protocol": "1.16.0",
    "pg-types": "2.2.0",
    "pgpass": "1.0.5",
    "postgres-array": "2.0.0",
    "postgres-bytea": "1.0.1",
    "postgres-date": "1.0.7",
    "postgres-interval": "1.2.0",
    "split2": "4.2.0",
    "xtend": "4.0.2"
