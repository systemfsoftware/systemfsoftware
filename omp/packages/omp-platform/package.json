{
  "name": "@systemfsoftware/omp-platform",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "description": "OMP host platform — project config and session lifecycle ports",
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "default": "./dist/index.js"
    },
    "./runtime-lifecycle": {
      "@systemfsoftware/source": "./src/RuntimeLifecycle.ts",
      "default": "./dist/runtime-lifecycle.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-memfs": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-refutation-vite": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./runtime-lifecycle": "./dist/runtime-lifecycle.js",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@std/toml": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "omp/packages/omp-platform"
  }
}
