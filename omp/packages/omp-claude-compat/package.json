{
  "name": "@systemfsoftware/omp-claude-compat",
  "license": "MIT",
  "version": "0.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "description": "OMP Claude Code compatibility: dispatch .claude/settings.json hooks + inject CLAUDE.md @-references",
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsdown",
    "verify-dist": "node ../../scripts/check-dist-builtins.mjs --dist dist/index.js --expect node:child_process node:fs node:path",
    "postbuild": "pnpm verify-dist",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}"
  },
  "dependencies": {},
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "catalog:"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/omp-utils": "workspace:^",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "inlinedDependencies": {
    "@jsr/std__collections": "1.3.0",
    "@jsr/std__toml": "1.0.11"
  }
}
