{
  "name": "@systemfsoftware/omp-agent-discipline",
  "license": "Apache-2.0",
  "version": "2.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "description": "OMP agent discipline: mechanical enforcement of rules prose can't hold (xd:// retry guard, ...)",
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "attw --pack .",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}"
  },
  "optionalDependencies": {
    "@std/toml": "catalog:",
    "@systemfsoftware/omp-utils": "workspace:^"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "effect": "catalog:peers"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:attw",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-memfs": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/omp-utils": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "provenance": true
  },
  "inlinedDependencies": {
    "@effect/platform-node": "4.0.0-rc.111",
    "@effect/platform-node-shared": "4.0.0-rc.111",
    "@jsr/std__collections": "1.3.0",
    "@jsr/std__toml": "1.0.11",
    "effect": "4.0.0-rc.111"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "omp/plugins/omp-agent-discipline"
  }
}
