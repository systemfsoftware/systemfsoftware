{
  "name": "@systemfsoftware/omp-claude-compat",
  "license": "MIT",
  "version": "1.1.4",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "description": "OMP Claude Code compatibility: dispatch .claude/settings.json hooks + inject CLAUDE.md @-references",
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "lint": "oxlint . ${AGENT:+--format=unix --quiet}"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-memfs": "workspace:^",
    "@systemfsoftware/omp-utils": "workspace:^",
    "@systemfsoftware/oxlint-config": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "provenance": true
  },
  "inlinedDependencies": {
    "@jsr/std__collections": "1.3.0",
    "@jsr/std__toml": "1.0.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "omp/plugins/omp-claude-compat"
  }
}
