{
  "extends": "@systemfsoftware/stryker-js-mutation-run/config/base",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.property.test.ts",
    "!src/**/*.d.ts",
    "!src/**/__tests__/**"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": [
    "reports",
    "coverage",
    "dist"
  ],
  "ignorers": [
    "effect-schema-declarations",
    "workflow-make-boundary"
  ]
}
