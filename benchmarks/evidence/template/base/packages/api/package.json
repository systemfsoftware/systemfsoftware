{
  "private": true,
  "name": "{{apiPackageName}}",
  "version": "0.1.0",
  "description": "Generated API SDK and authored DTO package for {{name}}",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "format": "ttsc format",
    "lint": "ttsc --noEmit"
  },
  "dependencies": {
    "@nestia/fetcher": "catalog:samchon",
    "typia": "catalog:samchon"
  },
  "devDependencies": {
    "@ttsc/lint": "catalog:typescript",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript"
  }
}
