{
  "nodeModulesDir": "none",
  "imports": {
    "@effect/vitest": "npm:@effect/vitest@4.0.0-rc.112",
    "@effect/platform-deno": "npm:@effect/platform-deno@4.0.0-rc.112",
    "effect": "npm:effect@4.0.0-rc.112",
    "@systemfsoftware/effect-cell-types": "npm:@systemfsoftware/effect-cell-types@5.0.1",
  },
  "tasks": {
    "check": "deno check src/ && deno lint src/",
    "lint:oxlint": "../../node_modules/.bin/oxlint -c ./oxlint.config.ts --tsconfig ./tsconfig.json -f unix ./src/",
  },
  "publish": {
    "exclude": ["**"],
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
    },
  },
}
