{
  // Config for everything under scripts/ — the map tool and the guards.
  // Deno discovers it by walking up from each script, so invocations need no
  // --config flag. nodeModulesDir none keeps pnpm's node_modules untouched and
  // stops Deno from migrating pnpm-workspace.yaml into package.json.
  "imports": {
    "@std/cli/parse-args": "jsr:@std/cli@1.0.32/parse-args",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "@toon-format/toon": "npm:@toon-format/toon@^4.1.1",
  },
  "nodeModulesDir": "none",
}
