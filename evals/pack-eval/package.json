{
  "name": "@systemfsoftware/pack-eval",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "description": "Measures how well an agent's rule selection routes compound pack rules, and which rule pairs contradict on a task that needs both.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/systemfsoftware.git",
    "directory": "evals/pack-eval"
  },
  "type": "module",
  "bin": {
    "pack-eval": "./dist/main.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown -l warn",
    "clean": "rimraf dist",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}"
  },
  "dependencies": {
    "@effect/ai-openrouter": "catalog:",
    "@effect/platform-node": "catalog:",
    "@systemfsoftware/effect-cell-types": "workspace:^",
    "effect": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "workspace:^",
    "@systemfsoftware/effect-schema-law": "workspace:^",
    "@systemfsoftware/effect-schema-vite": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "workspace:^",
    "@systemfsoftware/tsconfig": "workspace:^",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
