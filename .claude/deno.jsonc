{
  // Config for everything under .claude/. Deno discovers it by walking up from
  // each hook, so the shebangs stay permission-scoped and need no --config flag.
  //
  // Deliberately carries no "name", "version" or "exports": without them
  // `deno publish` refuses outright, so this tree cannot reach JSR by accident.
  // A flag could be flipped back on; a missing package identity cannot.
  //
  // Subpaths are mapped exactly (@std/path/posix), never by trailing-slash
  // prefix: Deno cannot URL-parse a suffix against a "jsr:" prefix mapping and
  // fails to resolve at check time.
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path/posix": "jsr:@std/path@^1.1.2/posix",
    "@std/streams": "jsr:@std/streams@^1.0.12",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.15/bdd",
    "just-bash": "npm:just-bash@3.2.0",
  },
  // dprint is this repo's formatter and owns these files (`pnpm format`), so no
  // "fmt" block lives here and the task never runs `deno fmt` — two formatters
  // over one tree means whichever ran last wins and the gate flaps.
  "tasks": {
    "check": "deno check hooks/ && deno lint hooks/",
  },
  "publish": {
    "exclude": ["**"],
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
    },
  },
}
